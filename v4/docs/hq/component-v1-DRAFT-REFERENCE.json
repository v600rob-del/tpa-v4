{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:tpa:v4:component:1",
  "title": "TPA v4 component snapshot 1.0 — draft, subject to HQ acceptance",
  "type": "object",
  "additionalProperties": false,
  "required": ["component", "contractVersion", "health", "receivedAt", "expiresAt", "entities", "attribution"],
  "properties": {
    "component": {"type": "string", "enum": ["air", "sea", "rail", "bus", "road"]},
    "contractVersion": {"const": "1.0"},
    "health": {"type": "string", "enum": ["ready", "stale", "unavailable", "not_installed"]},
    "observedAt": {"type": ["string", "null"], "format": "date-time"},
    "receivedAt": {"type": "string", "format": "date-time"},
    "expiresAt": {"type": "string", "format": "date-time"},
    "nextPollAfterMs": {"type": "integer", "minimum": 5000, "maximum": 600000},
    "attribution": {"type": "string", "maxLength": 256},
    "entities": {
      "type": "array", "maxItems": 10000,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "label", "position", "quality", "observedAt"],
        "properties": {
          "id": {"type": "string", "maxLength": 128, "minLength": 1},
          "label": {"type": "string", "maxLength": 160},
          "observedAt": {"type": "string", "format": "date-time"},
          "quality": {"enum": ["observed", "estimated", "stale"]},
          "position": {
            "anyOf": [
              {"type": "null"},
              {"type": "object", "additionalProperties": false, "required": ["lat", "lon"],
               "properties": {"lat": {"type": "number", "minimum": -90, "maximum": 90}, "lon": {"type": "number", "minimum": -180, "maximum": 180}, "headingDeg": {"type": ["number", "null"], "minimum": 0, "maximum": 360}}}
            ]
          }
        }
      }
    }
  }
}
