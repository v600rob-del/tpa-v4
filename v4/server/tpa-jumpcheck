#!/usr/bin/env python3
"""tpa-jumpcheck (kit 4.14.2, owner 3 Nov 16:04: buses "do short smooth movements for a few seconds then jump").
Read-only. Asks the bus engine for the same map area every 3 seconds for a minute - exactly as the map page would -
and checks whether each new answer puts every bus where the previous answer said it would be at that moment.
A difference over 30 m is a jump on screen. Prints how many there were, of which kind, and a few examples.
Run on the main server:  sudo tpa-jumpcheck [west south east north]   (default: central Hull)"""
import json
import math
import re
import sys
import time
import urllib.request


def bus_host():
    try:
        for line in open('/etc/tpa/remote.env'):
            m = re.fullmatch(r'TPA_REMOTE_BUS=([0-9.]+)\s*', line)
            if m:
                return m.group(1)
    except OSError:
        pass
    try:
        return open('/etc/tpa/bus-bind').read().strip() or '127.0.0.1'
    except OSError:
        return '127.0.0.1'


def where(e, t):
    """Where this answer says the bus is at clock time t (epoch s), and how it moves."""
    m = e.get('motion') or {}
    p = e['position']
    if m.get('mode') == 'timed':
        T, P = m['times'], m['points']
        if t <= T[0]:
            return P[0], 'timed'
        for i in range(1, len(T)):
            if T[i] >= t:
                q = (t - T[i - 1]) / (T[i] - T[i - 1]) if T[i] > T[i - 1] else 1
                a, b = P[i - 1], P[i]
                return (a[0] + (b[0] - a[0]) * q, a[1] + (b[1] - a[1]) * q), 'timed'
        return P[-1], 'timed'
    return (p['lon'], p['lat']), m.get('mode') or 'still'


def metres(a, b):
    dx = (a[0] - b[0]) * 111320 * math.cos(math.radians(a[1]))
    return math.hypot(dx, (a[1] - b[1]) * 110540)


def main():
    box = sys.argv[1:5] if len(sys.argv) >= 5 else ['-0.43', '53.725', '-0.36', '53.755']
    url = f'http://{bus_host()}:8781/snapshot?west={box[0]}&south={box[1]}&east={box[2]}&north={box[3]}'
    opener = urllib.request.build_opener(urllib.request.ProxyHandler({}))
    print('Asking', url, 'every 3 s for 60 s (read-only)...')
    prev, kinds, examples, compared, asks, slow = {}, {}, [], 0, 0, []
    for _ in range(20):
        t0 = time.time()
        try:
            with opener.open(url, timeout=10) as r:
                f = json.load(r)
        except Exception as exc:
            print('  no answer:', type(exc).__name__, exc)
            time.sleep(3)
            continue
        took = time.time() - t0
        slow.append(took)
        asks += 1
        now = time.time()
        cur = {e['id']: e for e in f.get('entities', []) if e.get('position')}
        for k, e in cur.items():
            if k not in prev:
                continue
            (a, ma), (b, mb) = where(prev[k], now), where(e, now)
            if ma != 'timed' or mb != 'timed':      # only replayed buses can be compared exactly
                kinds[f'{ma}->{mb}'] = kinds.get(f'{ma}->{mb}', 0) + 1
                continue
            compared += 1
            d = metres(a, b)
            if d > 30:
                kinds['timed jump'] = kinds.get('timed jump', 0) + 1
                if len(examples) < 8:
                    examples.append(f"  {time.strftime('%H:%M:%S')} {e['label'][:30]:30} {k[:34]:34} {d:5.0f} m  "
                                    f"first point {prev[k]['motion']['times'][0]:.0f} -> {e['motion']['times'][0]:.0f}")
        prev = cur
        time.sleep(max(0, 3 - (time.time() - t0)))
    print(f'Answers: {asks} of 20, slowest {max(slow, default=0):.1f} s, typical {sorted(slow)[len(slow) // 2] if slow else 0:.1f} s')
    print(f'Replayed buses compared answer-to-answer: {compared}; jumps over 30 m: {kinds.get("timed jump", 0)}')
    others = {k: v for k, v in kinds.items() if k != 'timed jump'}
    if others:
        print('Not replayed (moved the older way), answer-to-answer:', ', '.join(f'{k} {v}' for k, v in sorted(others.items())))
    for x in examples:
        print(x)
    print('Clock on this server:', time.strftime('%H:%M:%S'), '(compare with the bus server: ssh ... date)')


if __name__ == '__main__':
    main()
