            buses = live_buses(x)
        return calibrate(buses, txc_journeys(open(txc, 'rb').read()), nocs)
    if '--calibrate' in sys.argv:
        i = sys.argv.index('--calibrate')
        nocs = [n.strip().upper() for n in sys.argv[i + 1].split(',')] if i + 1 < len(sys.argv) else list(STAGECOACH)
        k = key()
        print('Downloading the national bus file once (about a minute)...', flush=True)
        raw = get(URL + '?' + urlencode({'api_key': k}), 400 * 1024 * 1024)
        with zipfile.ZipFile(io.BytesIO(raw)) as zf:
            with zf.open(next(n for n in zf.namelist() if n.lower().endswith('.xml'))) as x:
                buses = live_buses(x)
        del raw
        print(f'Live buses: {len(buses)}. Now the timetables, company by company (a few minutes)...', flush=True)
        return calibrate(buses, fetch_txc_for(nocs, k), nocs)
    if '--timetables' in sys.argv:
        i = sys.argv.index('--timetables')
        pick = sys.argv[i + 1].split(',') if i + 1 < len(sys.argv) else list(BIGGEST)
        timetables([p.strip().upper() for p in pick if p.strip()])
        return
    if '--file' in sys.argv:
        raw = open(sys.argv[sys.argv.index('--file') + 1], 'rb').read()
    else:
        print('Downloading the national bus file once (about a minute)...', flush=True)
        req = Request(URL + '?' + urlencode({'api_key': key()}),
                      headers={'User-Agent': 'TPA-Bus-Kinds-Check/1.0 (+mailto:enquiries@tpalive.co.uk)'})
        with urlopen(req, timeout=120) as res:
            raw = res.read(400 * 1024 * 1024)
    if raw[:2] == b'PK':
        with zipfile.ZipFile(io.BytesIO(raw)) as zf:
            name = next(n for n in zf.namelist() if n.lower().endswith('.xml'))
            with zf.open(name) as xml:
                if '--fleet' in sys.argv:
                    return fleet(xml)
                result = survey(xml)
    else:
        if '--fleet' in sys.argv:
            return fleet(io.BytesIO(raw))
        result = survey(io.BytesIO(raw))
    report(*result)


