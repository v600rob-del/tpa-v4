        rows = html_rows(ey_raw)
        if not rows:
            plates = sorted(set(re.findall(r'\b[A-Z]{2}\d{2}\s?[A-Z]{3}\b', text)))
            print(f'No table found (the list may be drawn by the page itself). Number plates in the page: {len(plates)} '
                  + ' '.join(plates[:8]))
        match_report('East Yorkshire (EYMS) ids in its fleet list', rows,
                     [b for b in live if b['op'] == 'EYMS'], lambda b: (b['fleet'], b['uid']))
    print('\nNothing was changed. The bus key was not shown.')


def ey_peek(raw):
    """The page around two buses (one found, one not), and its words about copying - so the type and plate can be read."""
    text = raw.decode('utf-8', 'replace')
    print(f'\n=== East Yorkshire fleet page, a peek (look only) ===\nSize {len(raw)} bytes')
    for fleet in ('20376', '20313'):
        at = [m.start() for m in re.finditer(fleet, text)]
        print(f'\n--- fleet number {fleet}: appears {len(at)} times ---')
        if at:
            a = at[0]
            row = text.rfind('<tr', 0, a)
            end = text.find('</tr>', a)
            chunk = text[row if row >= 0 and a - row < 4000 else a - 1500: (end + 5 if 0 <= end - a < 4000 else a + 2500)]
            print(re.sub(r'\s+', ' ', chunk)[:3500])
    plates = sorted(set(re.findall(r'\b[A-Z]{2}\d{2}\s?[A-Z]{3}\b', text)))
    print(f'\nNumber plates written in the page: {len(plates)}, e.g. ' + ' '.join(plates[:10]))
    alts = collections.Counter(re.findall(r'(?:alt|title|aria-label)="([^"]{2,40})"', text))
    print('Picture labels in the page: ' + ', '.join(f'{k} x{v}' for k, v in alts.most_common(15)))
    for word in ('copyright', 'terms', 'reproduc', 'permission'):
        for m in list(re.finditer(word, text, re.I))[:2]:
            print(f'"{word}": ' + re.sub(r'<[^>]+>', ' ', re.sub(r'\s+', ' ', text[max(0, m.start() - 150): m.start() + 200])).strip()[:300])
    print('\nNothing was changed.')


def fetch_txc_for(nocs, k):
    """Every timetable dataset listed for these companies, each read once (the service lists a whole group's)."""
    journeys, done = [], set()
    for noc in nocs:
        try:
            listing = json.loads(get(API + '?' + urlencode({'noc': noc, 'status': 'published', 'limit': 100, 'api_key': k}), 10_000_000))
        except Exception as exc:
            print(f'{noc:<6} timetable list failed: {type(exc).__name__}', flush=True)
            continue
        sets = [d for d in listing.get('results') or [] if noc in [str(x).upper() for x in (d.get('noc') or [])]]
        new = [d for d in sets if (d.get('url') or '') not in done]
        print(f'{noc:<6} datasets for this company {len(sets)}, not yet read {len(new)}', flush=True)
        for ds in new:
            url = ds.get('url') or ''
            done.add(url)
            try:
                got = txc_journeys(get(url + ('&' if '?' in url else '?') + urlencode({'api_key': k})))
                print(f'       {str(ds.get("name") or "")[:60]}: {len(got)} journeys, {sum(1 for j in got if j["kind"])} with a type', flush=True)
                journeys.extend(got)
            except Exception as exc:
                print(f'       {str(ds.get("name") or "")[:60]}: could not read ({type(exc).__name__})', flush=True)
    return journeys


def timetables(nocs):
    k = key()
    print(f'\n=== Timetable files: do they name the kind of bus? (look only) ===')
    print('One timetable dataset per company; journeys that name a vehicle type, and the commonest types.\n', flush=True)
    for noc in nocs:
        try:
            listing = json.loads(get(API + '?' + urlencode({'noc': noc, 'status': 'published', 'limit': 5, 'api_key': k}), 5_000_000))
            sets = listing.get('results') or []
            if not sets:
                print(f'{noc:<6} no timetable dataset found')
                continue
            ds = sets[0]
            url = ds.get('url') or ''
            url = url + ('&' if '?' in url else '?') + urlencode({'api_key': k}) if 'api_key' not in url else url
            kinds, journeys = txc_kinds(get(url))
            named = sum(kinds.values())
            common = ', '.join(f'{c or "-"}/{d or "-"} x{n}' for (c, d), n in kinds.most_common(6)) or 'none named'
            print(f'{noc:<6} {str(ds.get("operator_name") or "")[:28]:<28} journeys {journeys:>6}  with a type {named:>6}  {common}', flush=True)
        except Exception as exc:
            print(f'{noc:<6} could not check: {type(exc).__name__} {str(exc)[:60].replace(k, "<key>")}', flush=True)
    print('\nNothing was changed. The bus key was not shown.')


