    if '--ey-peek' in sys.argv:                  # part 6: how East Yorkshire's page writes one bus (look only)
        i = sys.argv.index('--ey-peek')
        raw = open(sys.argv[i + 1], 'rb').read() if i + 1 < len(sys.argv) else get(EY_FLEET, 50_000_000)
        return ey_peek(raw)
    if '--fleetlists-files' in sys.argv:         # test: live file, TfL .xlsx, East Yorkshire page
        i = sys.argv.index('--fleetlists-files')
