def uk_hms(iso):
    from datetime import datetime
    from zoneinfo import ZoneInfo
    try:
        return datetime.fromisoformat(iso.strip().replace('Z', '+00:00')).astimezone(ZoneInfo('Europe/London')).strftime('%H:%M:%S')
    except ValueError:
        return ''


def live_buses(xml):
    """[{op, fleet, line, dep, dated, ticket}] from the live national file."""
    out = []
    for _e, elem in iterparse(xml):
        if local(elem.tag) != 'VehicleActivity':
            continue
        b = {'op': '', 'fleet': '', 'uid': '', 'line': '', 'dep': '', 'dated': '', 'ticket': ''}
        for c in elem.iter():
            n, t = local(c.tag), (c.text or '').strip()
            if n == 'OperatorRef' and not b['op']:
                b['op'] = t.upper()
            elif n == 'VehicleRef':
                b['fleet'] = t
            elif n == 'VehicleUniqueId':
                b['uid'] = t
            elif n == 'PublishedLineName':
                b['line'] = t.lower()
            elif n == 'OriginAimedDepartureTime':
                b['dep'] = uk_hms(t)
            elif n == 'DatedVehicleJourneyRef':
                b['dated'] = t
            elif n == 'JourneyCode':
                b['ticket'] = t
        # 16:20 (Nottingham): everything packed in one journey code, e.g.
        # 1073-NT79-In-18078-NT3300GE0341-2026-11-10T10:25:00-2026-11-10 = ticket number, route, direction, ..., departure
        packed = re.match(r'^(\d+)-[A-Z]*?(\w+)-(?:In|Out|I|O)-.*?\d{4}-\d\d-\d\dT(\d\d:\d\d:\d\d)', b['dated'])
        if packed:
            b['ticket'] = b['ticket'] or packed.group(1)
            b['line'] = b['line'] or packed.group(2).lower()
            b['dep'] = b['dep'] or packed.group(3)
        num = re.sub(r'\D', '', b['fleet'].split('-')[-1])
        if not num or not re.fullmatch(r'[A-Z]*-?\d+', b['fleet'].upper()):
            num = re.sub(r'\D', '', b['uid'])
        b['num'] = num
        out.append(b)
        elem.clear()
    return out


def txc_journeys(raw):
    """[{noc, code, ticket, line, dep, kind}] from TransXChange (zip, zips in a zip, or one file)."""
    out = []

    def one(xml):
        lines, ops, services, js = {}, {}, {}, []
        for _e, el in iterparse(xml):
            n = local(el.tag)
            if n == 'Line':
                lines[el.get('id', '')] = next((x.text or '' for x in el.iter() if local(x.tag) == 'LineName'), '').strip().lower()
            elif n in ('Operator', 'LicensedOperator'):
                ops[el.get('id', '')] = next((x.text or '' for x in el.iter() if local(x.tag) == 'NationalOperatorCode'), '').strip().upper()
            elif n == 'Service':      # Stagecoach names the company once per service, not on each journey
                code = next((x.text or '' for x in el if local(x.tag) == 'ServiceCode'), '').strip()
                reg = next((x.text or '' for x in el if local(x.tag) == 'RegisteredOperatorRef'), '').strip()
                if code:
                    services[code] = reg
            elif n == 'VehicleJourney':
                j = {'code': '', 'ticket': '', 'line': '', 'dep': '', 'kind': '', 'op': '', 'svc': ''}
                for x in el.iter():
                    m, t = local(x.tag), (x.text or '').strip()
                    if m == 'VehicleJourneyCode':
                        j['code'] = t
                    elif m == 'JourneyCode':
                        j['ticket'] = t
                    elif m == 'LineRef':
                        j['line'] = t
                    elif m == 'DepartureTime':
                        j['dep'] = t
                    elif m == 'OperatorRef':
                        j['op'] = t
                    elif m == 'ServiceRef':
                        j['svc'] = t
                for vt in (x for x in el.iter() if local(x.tag) == 'VehicleType'):
                    d = next((y.text or '' for y in vt.iter() if local(y.tag) == 'Description'), '').strip()
                    c = next((y.text or '' for y in vt.iter() if local(y.tag) == 'VehicleTypeCode'), '').strip()
                    j['kind'] = (d or c)[:40]
                js.append(j)
                el.clear()
        only = next(iter(ops.values()), '') if len(set(ops.values())) == 1 else ''
        for j in js:
            op, svc = j.pop('op'), j.pop('svc')
            j['noc'] = ops.get(op, '') or ops.get(services.get(svc, ''), '') or only
            j['line'] = lines.get(j['line'], j['line']).lower()
            out.append(j)
    if raw[:2] == b'PK':
        with zipfile.ZipFile(io.BytesIO(raw)) as zf:
            for name in zf.namelist():
                if name.lower().endswith('.xml'):
                    with zf.open(name) as x:
                        one(x)
                elif name.lower().endswith('.zip'):
                    out.extend(txc_journeys(zf.read(name)))
    else:
        one(io.BytesIO(raw))
    return out


def calibrate(buses, journeys, nocs):
    """Match live buses to their timetabled journey; count which fleet numbers run which kind of bus.
    Tries, in order: the ticket machine's journey code, the journey's own code, then route + departure time - each
    always within the same company."""
    by = collections.defaultdict(list)
    for j in journeys:
        if j['kind']:
            for k in (('tl', j['noc'], j['ticket'], j['line']), ('t', j['noc'], j['ticket']), ('c', j['noc'], j['code']),
                      ('l', j['noc'], j['line'], j['dep'][:5])):
                if all(k[2:]) and k[1]:
                    by[k].append(j['kind'])
    print('\n=== Fleet numbers against the timetable (look only) ===')
    print(f'Timetable journeys read: {len(journeys)}, naming a type: {sum(1 for j in journeys if j["kind"])}')
    per = collections.Counter(j['noc'] or '(none)' for j in journeys if j['kind'])
    print('Journeys naming a type, by company: ' + ', '.join(f'{k} {v}' for k, v in per.most_common(20)))
    sample = [j for j in journeys if j['kind']][:3]
    for j in sample:
        print(f'  timetable example: company {j["noc"] or "-"}, ticket {j["ticket"] or "-"}, code {j["code"] or "-"}, route {j["line"] or "-"}, leaves {j["dep"] or "-"}, kind {j["kind"]}')
    first = collections.defaultdict(collections.Counter)
    two = collections.defaultdict(collections.Counter)
    one = collections.defaultdict(collections.Counter)
    how = collections.Counter()
    why = collections.Counter()
    odd = []
    for noc in nocs:
        mine = [b for b in buses if b['op'] == noc]
        hit = 0
        for b in mine:
            kinds, way, seen = [], '', False
            # 16:22 run (Nottingham, 7 of 258): a ticket number can be shared by several journeys of different kinds,
            # so each way is tried in turn and the first with ONE kind wins (12:40: always within the same company)
            for name, k in (('ticket code + route', ('tl', noc, b['ticket'], b['line'])), ('ticket code', ('t', noc, b['ticket'])),
                            ('journey code', ('c', noc, b['dated'])), ('route + time', ('l', noc, b['line'], b['dep'][:5]))):
                if all(k[2:]) and by.get(k):
                    seen = True
                    if len(set(by[k])) == 1:
                        kinds, way = by[k], name
                        break
            if not kinds or not b['num']:
                why['found, but more than one kind' if seen else 'no journey found'] += 1
                if len(odd) < 6:
                    odd.append(f"fleet {b['fleet']} route {b['line'] or '-'} ticket {b['ticket'] or '-'} left {b['dep'] or '-'}")
                continue
            hit += 1
            how[way] += 1
            first[b['num'][0] + 'x' * (len(b['num']) - 1)][kinds[0]] += 1
            two[b['num'][:2] + 'x' * (len(b['num']) - 2)][kinds[0]] += 1
            one[b['num']][kinds[0]] += 1
        has = lambda f: sum(1 for b in mine if b[f])
        print(f'{noc:<6} live buses {len(mine):>5}  (ticket code {has("ticket")}, journey code {has("dated")}, start time {has("dep")})'
              f'   matched with a type {hit:>5}')
        for b in mine[:2]:
            print(f'  live example: fleet {b["fleet"]}, ticket {b["ticket"] or "-"}, journey {b["dated"] or "-"}, route {b["line"] or "-"}, left {b["dep"] or "-"}')
    print('Matched by: ' + (', '.join(f'{k} {v}' for k, v in how.most_common()) or 'nothing'))
    print('Not matched: ' + (', '.join(f'{k} {v}' for k, v in why.most_common()) or 'none'))
    for o in odd:
        print('  not matched, e.g. ' + o)
    print('\n--- By the first digit of the fleet number ---')
    for d in sorted(first):
        print(f'  {d}  ' + ', '.join(f'{k} x{v}' for k, v in first[d].most_common()))
    print('\n--- By the first two digits ---')
    for d in sorted(two):
        print(f'  {d}  ' + ', '.join(f'{k} x{v}' for k, v in two[d].most_common()))
    print('\n--- Each bus (fleet number: kind of the journey it is running) ---')
    print('  ' + '  '.join(f'{n}:{"/".join(one[n])}' for n in sorted(one, key=lambda x: (len(x), x))))
    print('\nNothing was changed. The bus key was not shown.')


