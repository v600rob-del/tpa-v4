def norm(text):
    return re.sub(r'[^A-Z0-9]', '', (text or '').upper())


def xlsx_rows(raw):
    """Rows (lists of text) of the first worksheet of an .xlsx, with only the standard library."""
    with zipfile.ZipFile(io.BytesIO(raw)) as zf:
        shared = []
        if 'xl/sharedStrings.xml' in zf.namelist():
            for _e, el in iterparse(zf.open('xl/sharedStrings.xml')):
                if local(el.tag) == 'si':
                    shared.append(''.join(t.text or '' for t in el.iter() if local(t.tag) == 't'))
                    el.clear()
        sheet = sorted(n for n in zf.namelist() if re.match(r'xl/worksheets/sheet\d+\.xml$', n))[0]
        rows = []
        for _e, el in iterparse(zf.open(sheet)):
            if local(el.tag) != 'row':
                continue
            cells = {}
            for c in el:
                if local(c.tag) != 'c':
                    continue
                ref = re.sub(r'\d', '', c.get('r', ''))
                col = 0
                for ch in ref:
                    col = col * 26 + ord(ch) - 64
                v = next((x.text or '' for x in c.iter() if local(x.tag) in ('v', 't')), '')
                if c.get('t') == 's' and v.isdigit() and int(v) < len(shared):
                    v = shared[int(v)]
                cells[col - 1] = v.strip()
            if cells:
                rows.append([cells.get(i, '') for i in range(max(cells) + 1)])
            el.clear()
    return rows


def html_rows(raw):
    """Table rows (lists of cell text) in a web page."""
    from html.parser import HTMLParser

    class P(HTMLParser):
        def __init__(self):
            super().__init__()
            self.rows, self.row, self.cell = [], None, None

        def handle_starttag(self, tag, attrs):
            if tag == 'tr':
                self.row = []
            elif tag in ('td', 'th') and self.row is not None:
                self.cell = []

        def handle_endtag(self, tag):
            if tag in ('td', 'th') and self.cell is not None and self.row is not None:
                self.row.append(' '.join(''.join(self.cell).split()))
                self.cell = None
            elif tag == 'tr' and self.row is not None:
                if self.row:
                    self.rows.append(self.row)
                self.row = None

        def handle_data(self, data):
            if self.cell is not None:
                self.cell.append(data)
    p = P()
    p.feed(raw.decode('utf-8', 'replace'))
    return p.rows


def match_report(title, rows, live, ids):
    """How many live buses (their ids) appear anywhere in a fleet list's cells, and which column."""
    print(f'\n--- {title} ---')
    print(f'Rows in the list: {len(rows)}')
    for r in rows[:4]:
        print('  row: ' + ' | '.join(x[:24] for x in r[:14]))
    where = collections.defaultdict(dict)        # cell value -> row
    for r in rows:
        for i, x in enumerate(r):
            if norm(x):
                where[norm(x)][i] = r
    found, cols, missed = 0, collections.Counter(), []
    for b in live:
        hit = None
        for ident in ids(b):
            if norm(ident) in where:
                hit = where[norm(ident)]
                break
        if hit:
            found += 1
            cols.update(hit.keys())
        else:
            missed.append(' / '.join(i for i in ids(b) if i))
    print(f'Live buses: {len(live)}   found in the list: {found} ({100 * found / max(1, len(live)):.0f}%)')
    if cols:
        print('  matched in column(s): ' + ', '.join(f'{c + 1} x{n}' for c, n in cols.most_common(3)))
    print('  not found, examples: ' + ', '.join(missed[:10]))
    return found


