#!/usr/bin/env python3
"""tpa-bus-kinds: LOOK ONLY. Which buses say what kind of bus they are? (owner 10 Nov 11:08: "as much info as we
can at this stage to determine getting the right pics to the right buses")

Downloads the national BODS bus file ONCE (the same file the bus engine fetches every minute, with the same key from
/etc/tpa/bus.env), then lists every piece of information the buses send and how many buses send it - especially
seats, wheelchair spaces, occupancy and anything naming a vehicle type. Changes nothing; never prints the key.

Run on the server:  sudo python3 tpa-bus-kinds
Test with a saved file:  python3 tpa-bus-kinds --file bulk.zip

Part 2 (owner 11:12: the live feed sends no seats at all): --timetables looks in each big company's own timetable
files (TransXChange), which may name the vehicle type for each journey (Operational/VehicleType). One dataset per
company, fetched through the BODS timetable API with the same key; still look only.
  sudo python3 tpa-bus-kinds --timetables          (or: --timetables FYOR,TFLO to choose companies)
  python3 tpa-bus-kinds --txc-file some.zip         (test)
Part 3: --fleet lists the fleet numbers each company sends (look only).
"""
import json
import collections
import io
import re
import sys
import zipfile
from urllib.parse import urlencode
from urllib.request import Request, urlopen
from xml.etree.ElementTree import iterparse

URL = 'https://data.bus-data.dft.gov.uk/avl/download/bulk_archive'
HINT = re.compile(r'capacity|occupancy|seat|wheelchair|vehicletype|vehiclefeature|feature|model|deck|vehicle(unique)?id|fleet|registration', re.I)
SKIP = re.compile(r'^(Latitude|Longitude|Bearing|RecordedAtTime|ValidUntilTime|ItemIdentifier|BlockRef|Delay)$')


def key():
    for line in open('/etc/tpa/bus.env'):
        k, _, v = line.strip().partition('=')
        if k.strip() == 'TPA_BODS_API_KEY':
            return v.strip().strip('"\'')
    sys.exit('No bus key found in /etc/tpa/bus.env - nothing was downloaded.')


def local(tag):
    return tag.rsplit('}', 1)[-1]


def seats_band(n):
    return 'up to 20 (minibus?)' if n <= 20 else '21-35' if n <= 35 else '36-50 (single decker?)' if n <= 50 else '51+ (double decker?)'


def survey(xml):
    buses = 0
    paths = collections.Counter()                 # field -> buses sending it
    values = collections.defaultdict(collections.Counter)
    ops = collections.Counter()
    op_with = collections.defaultdict(collections.Counter)    # operator -> field -> buses
    bands = collections.defaultdict(collections.Counter)      # operator -> seat band -> buses
    stack = []
    for event, elem in iterparse(xml, events=('start', 'end')):
        name = local(elem.tag)
        if event == 'start':
            stack.append(name)
            continue
        stack.pop()
        if name != 'VehicleActivity':
            continue
        buses += 1
        seen, op, seated = set(), '', None

        def walk(e, path):
            nonlocal op, seated
            for c in e:
                n = local(c.tag)
                p = path + '/' + n if path else n
                if len(c):
                    walk(c, p)
                    continue
                if SKIP.match(n):
                    continue
                seen.add(p)
                text = (c.text or '').strip()
                if n == 'OperatorRef' and not op:
                    op = text[:20]
                if HINT.search(n) and text:
                    values[p][text[:40]] += 1
                if n == 'SeatedCapacity' and text.isdigit():
                    seated = int(text)
        walk(elem, '')
        op = op or '(none)'
        ops[op] += 1
        for p in seen:
            paths[p] += 1
            if HINT.search(p.rsplit('/', 1)[-1]):
                op_with[op][p] += 1
        if seated is not None:
            bands[op][seats_band(seated)] += 1
        elem.clear()
    return buses, paths, values, ops, op_with, bands


def fleet(xml):
    """Part 3 (owner 11:49: "every bus seems to be a double decker"): the fleet numbers each company sends, in shapes
    (9 = a digit, A = a letter) and by their first two digits - some groups number their buses by kind."""
    refs = collections.defaultdict(list)
    for _e, elem in iterparse(xml):
        if local(elem.tag) != 'VehicleActivity':
            continue
        op = ref = uid = ''
        for c in elem.iter():
            n = local(c.tag)
            if n == 'OperatorRef' and not op:
                op = (c.text or '').strip()[:20]
            elif n == 'VehicleRef' and not ref:
                ref = (c.text or '').strip()[:30]
            elif n == 'VehicleUniqueId':
                uid = (c.text or '').strip()[:30]
        refs[op or '(none)'].append((ref, uid))
        elem.clear()
    print('\n=== Fleet numbers by company (look only) ===')
    for op, got in sorted(refs.items(), key=lambda x: -len(x[1]))[:40]:
        shapes = collections.Counter(re.sub(r'[A-Za-z]', 'A', re.sub(r'[0-9]', '9', r)) for r, _ in got)
        nums = [re.sub(r'\D', '', r) for r, _ in got]
        lead = collections.Counter(n[:2] for n in nums if len(n) >= 4)
        sample = sorted({r for r, _ in got})
        step = max(1, len(sample) // 12)
        print(f'\n{op}  {len(got)} buses')
        print('  shapes: ' + ', '.join(f'{k} x{v}' for k, v in shapes.most_common(5)))
        print('  first two digits: ' + ', '.join(f'{k}.. x{v}' for k, v in sorted(lead.items(), key=lambda x: -x[1])[:12]))
        print('  examples: ' + ' '.join(sample[::step][:12]))
        uids = sorted({u for _, u in got if u})
        if uids:
            print('  also sends: ' + ' '.join(uids[::max(1, len(uids) // 6)][:6]))
    print('\nNothing was changed. The bus key was not shown.')


def report(buses, paths, values, ops, op_with, bands):
    pc = lambda n: f'{n:>6} ({100 * n / max(1, buses):.0f}%)'
    print(f'\n=== TPA bus kinds check (look only) ===\nBuses in the national file: {buses}\n')
    print('--- Every field the buses send, and how many buses send it ---')
    for p, n in sorted(paths.items(), key=lambda x: -x[1]):
        print(f'{pc(n)}  {p}')
    print('\n--- Fields that might tell us the kind of bus: their commonest values ---')
    hint_paths = [p for p in values if not re.search(r'VehicleRef$|VehicleUniqueId$', p)]
    if not hint_paths:
        print('(none)')
    for p in sorted(hint_paths, key=lambda x: -paths[x]):
        common = ', '.join(f'{v} x{n}' for v, n in values[p].most_common(12))
        print(f'{p}  [{len(values[p])} different]: {common}')
    print('\n--- Seats per bus (SeatedCapacity), all operators ---')
    total = collections.Counter()
    for b in bands.values():
        total.update(b)
    for band in ('up to 20 (minibus?)', '21-35', '36-50 (single decker?)', '51+ (double decker?)'):
        print(f'{pc(total[band])}  {band}')
    print(f'{pc(sum(total.values()))}  buses sending seats at all')
    print('\n--- Biggest 40 operators: buses, and how many send seats ---')
    for op, n in ops.most_common(40):
        s = sum(bands[op].values())
        short = {'up to 20 (minibus?)': 'mini', '21-35': 'small', '36-50 (single decker?)': 'single', '51+ (double decker?)': 'double'}
        detail = ', '.join(f'{short[k]} {v}' for k, v in sorted(bands[op].items(), key=lambda x: list(short).index(x[0])))
        print(f'{op:<12} {n:>5} buses   seats from {s:>5} ({100 * s / n:.0f}%)  {detail}')
    print('\nNothing was changed. The bus key was not shown.')


API = 'https://data.bus-data.dft.gov.uk/api/v1/dataset/'
BIGGEST = ('TFLO', 'WMBL', 'BNSM', 'FBRI', 'SCEM', 'BNML', 'GNEL', 'SCSO', 'NATX', 'SDVN', 'AMSY', 'SYRK', 'FLDS',
           'FSYO', 'EYMS', 'NCTR', 'TBTN', 'ARBB', 'FYOR', 'TDTR')
LIMIT = 300 * 1024 * 1024


def txc_kinds(stream_or_zip):
    """Counter of vehicle types named in TransXChange: (code, description) -> journeys; plus journeys seen."""
    kinds, journeys = collections.Counter(), 0

    def one(xml):
        nonlocal journeys
        for _e, el in iterparse(xml):
            n = local(el.tag)
            if n == 'VehicleJourney':
                journeys += 1
                el.clear()
            elif n == 'VehicleType':
                code = desc = ''
                for c in el.iter():
                    if local(c.tag) == 'VehicleTypeCode':
                        code = (c.text or '').strip()[:20]
                    elif local(c.tag) == 'Description':
                        desc = (c.text or '').strip()[:40]
                kinds[(code, desc)] += 1
    raw = stream_or_zip
    if raw[:2] == b'PK':
        with zipfile.ZipFile(io.BytesIO(raw)) as zf:
            for name in zf.namelist():
                if name.lower().endswith('.xml'):
                    with zf.open(name) as x:
                        one(x)
                elif name.lower().endswith('.zip'):
                    inner_kinds, inner_journeys = txc_kinds(zf.read(name))
                    kinds.update(inner_kinds)
                    journeys += inner_journeys
    else:
        one(io.BytesIO(raw))
    return kinds, journeys


def get(url, limit=LIMIT):
    req = Request(url, headers={'User-Agent': 'TPA-Bus-Kinds-Check/1.1 (+mailto:enquiries@tpalive.co.uk)'})
    with urlopen(req, timeout=180) as res:
        raw = res.read(limit + 1)
    if len(raw) > limit:
        raise ValueError('bigger than 300 MB - skipped')
    return raw


def timetables(nocs):
    k = key()
    print(f'\n=== Timetable files: do they name the kind of bus? (look only) ===')
    print('One timetable dataset per company; journeys that name a vehicle type, and the commonest types.\n', flush=True)
    for noc in nocs:
        try:
            listing = json.loads(get(API + '?' + urlencode({'noc': noc, 'status': 'published', 'limit': 5, 'api_key': k}), 5_000_000))
            sets = listing.get('results') or []
            if not sets:
                print(f'{noc:<6} no timetable dataset found')
                continue
            ds = sets[0]
            url = ds.get('url') or ''
            url = url + ('&' if '?' in url else '?') + urlencode({'api_key': k}) if 'api_key' not in url else url
            kinds, journeys = txc_kinds(get(url))
            named = sum(kinds.values())
            common = ', '.join(f'{c or "-"}/{d or "-"} x{n}' for (c, d), n in kinds.most_common(6)) or 'none named'
            print(f'{noc:<6} {str(ds.get("operator_name") or "")[:28]:<28} journeys {journeys:>6}  with a type {named:>6}  {common}', flush=True)
        except Exception as exc:
            print(f'{noc:<6} could not check: {type(exc).__name__} {str(exc)[:60].replace(k, "<key>")}', flush=True)
    print('\nNothing was changed. The bus key was not shown.')


def main():
    if '--txc-file' in sys.argv:
        kinds, journeys = txc_kinds(open(sys.argv[sys.argv.index('--txc-file') + 1], 'rb').read())
        print(f'journeys {journeys}  with a type {sum(kinds.values())}  ' + ', '.join(f'{c}/{d} x{n}' for (c, d), n in kinds.most_common()))
        return
    if '--timetables' in sys.argv:
        i = sys.argv.index('--timetables')
        pick = sys.argv[i + 1].split(',') if i + 1 < len(sys.argv) else list(BIGGEST)
        timetables([p.strip().upper() for p in pick if p.strip()])
        return
    if '--file' in sys.argv:
        raw = open(sys.argv[sys.argv.index('--file') + 1], 'rb').read()
    else:
        print('Downloading the national bus file once (about a minute)...', flush=True)
        req = Request(URL + '?' + urlencode({'api_key': key()}),
                      headers={'User-Agent': 'TPA-Bus-Kinds-Check/1.0 (+mailto:enquiries@tpalive.co.uk)'})
        with urlopen(req, timeout=120) as res:
            raw = res.read(400 * 1024 * 1024)
    if raw[:2] == b'PK':
        with zipfile.ZipFile(io.BytesIO(raw)) as zf:
            name = next(n for n in zf.namelist() if n.lower().endswith('.xml'))
            with zf.open(name) as xml:
                if '--fleet' in sys.argv:
                    return fleet(xml)
                result = survey(xml)
    else:
        if '--fleet' in sys.argv:
            return fleet(io.BytesIO(raw))
        result = survey(io.BytesIO(raw))
    report(*result)


if __name__ == '__main__':
    main()
