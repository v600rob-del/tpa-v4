#!/usr/bin/env python3
"""tpa-matchcheck - LOOK-ONLY count of how buses are linked to their timetable journeys on the real server.

Public report 22 Nov 2026 (Portsmouth, fleet 26296): the box said "Bus 39 to Havant" (from the bus itself) but its text
and stops were First's number 7, the 12:35 from Blackbird Close (from the timetable). Read in the code (bus 0.26.1,
timetable.Timetable.match): a bus is linked by the stop its journey started at and its departure time; the route
number, end stop, bus company and journey code are only used to choose when SEVERAL journeys fit. When exactly one fits
it is taken, even if its route number and company differ from what the bus is sending.

Before any guard is designed, this counts, for every bus in the engine's last saved reports, the journey the engine's
own matching gives it and whether that journey's route number or company code differs from the bus's own, or whether
the report came well after the journey should have finished. Examples are listed so differences that are only spelling
(e.g. a company publishing its timetable under another code) can be told apart from real wrong matches.

It changes nothing: the timetable is opened read-only, the saved reports are only read, nothing is written (not even
Python's cache files), the live engine is not asked anything.

  sudo nice -n 10 python3 -B -u tpa-matchcheck [timetable.py] [bus data folder]
"""
import importlib.util
import json
import math
import os
import sys
import time
from collections import Counter
from datetime import datetime

sys.dont_write_bytecode = True          # look-only: no __pycache__ beside the live engine's files

TIMETABLE_PY = '/opt/tpa/layers/bus/v4/engines/bus/timetable.py'
DATA = '/var/lib/tpa/bus'
WATCH = ('26296', '27182')              # the Portsmouth (22 Nov) and Hull (23 Nov) buses Rob reported
LATE_END_MIN = 30                       # a report this long after the journey's timetabled end counts as "after its end"
EXAMPLES = 6
FLAGS = ('route number differs', 'company code differs', f'report over {LATE_END_MIN} min after the journey ended')
# 24 Nov 21:05 (Rob: the buses still reporting after their journey ended - "both, in order please"): where those buses are
NEAR_M = 300                            # this close to a stop counts as "at" it
STILL_M = 200                           # moved less than this over its last 10 minutes of reports counts as standing still
WHERE = ('at its last stop', 'back at its first stop', 'elsewhere, standing still', 'elsewhere, moving',
         'elsewhere, movement not known')
AT_END = 'standing at its last stop after its due time (box shows a growing "late")'


def say(text):
    print(text, flush=True)


def load_timetable(path_py, path_db):
    spec = importlib.util.spec_from_file_location('tpa_timetable_look', path_py)
    m = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(m)
    return m.Timetable(path_db)


def norm(s):
    return ''.join((s or '').lower().split())


def journey(tt, trip_id):
    """(route number, company code, company name, first departure s, last arrival s) of one timetabled journey."""
    with tt.lock:
        row = tt.db.execute('SELECT r.short_name, a.noc, a.name, e.first_dep, e.last_arr FROM trips t '
                            'LEFT JOIN routes r ON r.route_id = t.route_id LEFT JOIN agency a ON a.agency_id = r.agency_id '
                            'JOIN trip_ends e ON e.trip_id = t.trip_id WHERE t.trip_id=?', (trip_id,)).fetchone()
    return tuple(row) if row else ('', '', '', 0, 0)


def metres(lat1, lon1, lat2, lon2):
    k = math.pi / 180
    x = (lon2 - lon1) * k * math.cos((lat1 + lat2) / 2 * k)
    return 6371000 * math.hypot(x, (lat2 - lat1) * k)


def ends(tt, trip_id):
    """((lat, lon) of the journey's first stop, (lat, lon) of its last stop) - None where not known."""
    with tt.lock:
        row = tt.db.execute('SELECT f.lat, f.lon, l.lat, l.lon FROM trip_ends e LEFT JOIN stops f ON f.stop_id = e.first_stop '
                            'LEFT JOIN stops l ON l.stop_id = e.last_stop WHERE e.trip_id=?', (trip_id,)).fetchone()
    if not row:
        return None, None
    return (row[0], row[1]) if row[0] is not None else None, (row[2], row[3]) if row[2] is not None else None


def moved_m(v, hist):
    """Furthest it has been from where it is now over its last 10 minutes of reports (None: no history)."""
    try:
        lat, lon, t = float(v['lat']), float(v['lon']), float(v['recorded'])
    except (KeyError, TypeError, ValueError):
        return None
    pts = [h for h in (hist or []) if isinstance(h, (list, tuple)) and len(h) >= 3 and t - 600 <= h[0] <= t]
    if len(pts) < 2:
        return None
    return max(metres(lat, lon, h[1], h[2]) for h in pts)


def where(v, first, last, hist):
    """Which of WHERE a bus is (and its distances to its first and last stops, metres)."""
    try:
        lat, lon = float(v['lat']), float(v['lon'])
    except (KeyError, TypeError, ValueError):
        return WHERE[4], None, None
    d_last = metres(lat, lon, *last) if last else None
    d_first = metres(lat, lon, *first) if first else None
    if d_last is not None and d_last <= NEAR_M:
        return WHERE[0], d_first, d_last
    if d_first is not None and d_first <= NEAR_M:
        return WHERE[1], d_first, d_last
    m = moved_m(v, hist)
    return (WHERE[4] if m is None else WHERE[2] if m < STILL_M else WHERE[3]), d_first, d_last


def flags_for(v, j):
    """Which of FLAGS apply to bus report v linked to journey j (from journey()); also minutes past the journey's end."""
    short, tnoc, _name, dep, arr = j
    noc = v['key'].split(':', 1)[0]
    out = []
    if norm(v.get('route')) and norm(short) and norm(v.get('route')) != norm(short):
        out.append(FLAGS[0])
    if noc and tnoc and noc.upper() != (tnoc or '').upper():
        out.append(FLAGS[1])
    past = None
    try:
        started = datetime.fromisoformat(str(v['dep']).replace('Z', '+00:00')).timestamp()
        past = ((float(v['recorded']) - started) - ((arr or 0) - (dep or 0))) / 60
    except (KeyError, TypeError, ValueError):
        pass
    if past is not None and past > LATE_END_MIN:
        out.append(FLAGS[2])
    return out, past


def describe(v, j, past):
    short, tnoc, name, dep, _arr = j
    dep = dep or 0
    return (f"{v['key'][:30]}  bus says: {v.get('route', '')} to {(v.get('destination') or '')[:24]}  |  "
            f"timetable: {short} {tnoc} '{(name or '')[:26]}' {dep // 3600 % 24:02d}:{dep % 3600 // 60:02d}"
            + (f"  |  {past:+.0f} min after its end" if past is not None else ''))


def check(tt, buses, progress=None, history=None):
    """Counts, examples per flag and the watched buses' lines. Uses the engine's own matching (tt.match)."""
    count, examples, watch = Counter(), {f: [] for f in FLAGS + WHERE + (AT_END,)}, []
    history = history or {}
    for i, v in enumerate(buses):
        if progress and i and i % 4000 == 0:
            progress(i)
        noc = v['key'].split(':', 1)[0]
        if not (v.get('origin') and v.get('dep')):
            count['no start stop or time sent'] += 1
            continue
        got = tt.match(v['origin'], v['dep'], v.get('route', ''), v.get('dest', ''), noc, v.get('jref', ''))
        if len(got) != 1:
            count['not linked (none or several fit)'] += 1
            continue
        count['linked to one journey'] += 1
        j = journey(tt, got[0])
        fl, past = flags_for(v, j)
        line = describe(v, j, past)
        for f in fl:
            count[f] += 1
            if len(examples[f]) < EXAMPLES:
                examples[f].append(line)
        first, last = ends(tt, got[0])
        place, d_first, d_last = where(v, first, last, history.get(v['key']))
        extra = f"  |  {d_last / 1000:.1f} km from its last stop" if d_last is not None else ''
        if place == WHERE[0] and past is not None and past > 2:
            count[AT_END] += 1
            if len(examples[AT_END]) < EXAMPLES:
                examples[AT_END].append(line + extra)
        if FLAGS[2] in fl:
            count[place] += 1
            band = '30-60 min' if past <= 60 else '1-2 hours' if past <= 120 else 'over 2 hours'
            count['after its end: ' + band] += 1
            if len(examples[place]) < EXAMPLES:
                m = moved_m(v, history.get(v['key']))
                examples[place].append(line + extra + (f", moved {m:.0f} m in 10 min" if m is not None else ''))
        if FLAGS[0] in fl and FLAGS[1] in fl:
            count['route number AND company differ'] += 1
        if fl:
            count['linked with at least one difference'] += 1
        if any(w in v['key'] for w in WATCH):
            watch.append(line + '  |  ' + (', '.join(fl) if fl else 'no difference'))
    return count, examples, watch


def main(argv):
    path_py = argv[1] if len(argv) > 1 else TIMETABLE_PY
    data = argv[2] if len(argv) > 2 else DATA
    path_db, path_saved = os.path.join(data, 'timetable.sqlite'), os.path.join(data, 'buses-last-reports.json')
    missing = [p for p in (path_py, path_db, path_saved) if not os.path.exists(p)]
    if missing:
        say('=== COPY BACK START ===')
        say('Not found (nothing was run): ' + ', '.join(missing))
        say('=== COPY BACK END ===')
        return 2
    say('tpa-matchcheck: look-only, changes nothing. About 1-2 minutes; a line every 4,000 buses.')
    tt = load_timetable(path_py, path_db)
    with open(path_saved, encoding='utf-8') as f:
        saved = json.load(f)
    buses = saved.get('vehicles') or []
    say(f"{len(buses)} buses in the engine's last saved reports ({round(time.time() - saved.get('savedAt', time.time()))} s old)")
    t0 = time.time()
    count, examples, watch = check(tt, buses, lambda i: say(f'  ...{i} of {len(buses)} ({time.time() - t0:.0f} s)'),
                                   saved.get('history') or {})
    say('=== COPY BACK START ===')
    say(f"tpa-matchcheck {time.strftime('%d %b %H:%M')}: {len(buses)} buses, {time.time() - t0:.0f} s")
    for k in ('linked to one journey', 'linked with at least one difference') + FLAGS + (
            'route number AND company differ', 'not linked (none or several fit)', 'no start stop or time sent'):
        say(f'{k}: {count[k]}')
    say(f'-- of the {count[FLAGS[2]]} reporting over {LATE_END_MIN} min after their journey ended, where they are:')
    for k in WHERE + tuple('after its end: ' + b for b in ('30-60 min', '1-2 hours', 'over 2 hours')):
        say(f'  {k}: {count[k]}')
    say(f'{AT_END}: {count[AT_END]}')
    for f in FLAGS + WHERE + (AT_END,):
        if examples[f]:
            say(f'-- examples: {f}')
            for line in examples[f]:
                say('  ' + line)
    say('-- fleet 26296 / 27182 now:')
    for line in watch or ['(neither is in the saved reports now)']:
        say('  ' + line)
    say('=== COPY BACK END ===')
    return 0


if __name__ == '__main__':
    sys.exit(main(sys.argv))
