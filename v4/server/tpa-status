#!/bin/bash
# tpa-status - plain-English health check. Shows no keys or passwords.
set -uo pipefail
# Needs admin rights to read the site settings; ask for them by itself.
if [[ $EUID -ne 0 ]]; then exec sudo -n "$0" "$@"; fi
ok=1
printf '%-32s %-9s %s\n' "Part" "State" "Memory"
for s in tpa-road tpa-bus tpa-air tpa-rail tpa-hq tpa-web; do
    st="$(systemctl is-active "$s" 2>/dev/null || true)"
    [[ "$st" == active ]] || ok=0
    mem="$(systemctl show -p MemoryCurrent --value "$s" 2>/dev/null)"
    max="$(systemctl show -p MemoryMax --value "$s" 2>/dev/null)"
    if [[ "$mem" =~ ^[0-9]+$ ]]; then
        if [[ "$max" =~ ^[0-9]+$ ]]; then mem="$((mem / 1048576)) MB of $((max / 1048576)) MB"; else mem="$((mem / 1048576)) MB"; fi
    else mem=""; fi
    printf '%-32s %-9s %s\n' "$s" "$st" "$mem"
done
echo
summary() {  # name port
    local raw
    raw="$(curl -fsS --max-time 3 "http://127.0.0.1:$2/status" 2>/dev/null)" || { printf '%-8s no answer\n' "$1"; ok=0; return; }
    printf '%s' "$raw" | python3 -c '
import json, sys
name = sys.argv[1]
d = json.load(sys.stdin)
keep = ("engineVersion", "health", "notice", "loginConfigured", "keyConfigured", "connected", "alwaysOn",
        "trainsTracked", "stationsKnown", "trackMapLoaded", "busesInLastDownload", "busesWithSpeed",
        "reportAgeMedianSeconds", "lastFetchSeconds", "roadMap", "roadMapSource", "roadMapDetail", "roadPathsKnown", "roadPathMs", "mode", "lastError",
        "referenceError", "trackError", "roadMapError", "roadCacheMB", "roadCacheLimitMB", "lastView")
parts = [f"{k}={d[k]}" for k in keep if k in d and d[k] not in ("", None)]
print(f"{name:8s} " + ", ".join(parts))
if isinstance(d.get("measure"), dict):   # bus 0.5.9: accuracy figures
    print(f"{'':8s} measure: " + ", ".join(f"{k}={v}" for k, v in d["measure"].items() if v is not None))
' "$1"
}
summary road 8782; summary bus 8781; summary air 8783; summary rail 8784
code="$(curl -s --max-time 3 -o /dev/null -w '%{http_code}' -H 'Host: 127.0.0.1:8778' http://127.0.0.1:8778/api/v4/manifest)"
printf '%-8s %s\n' "hq" "manifest HTTP $code"
[[ "$code" == 200 ]] || ok=0
host="$(sed -n 's/^TPA_HOST="\(.*\)"$/\1/p' /etc/tpa/web.env 2>/dev/null)"
if [[ -n "$host" ]]; then
    code="$(curl -s --max-time 8 -o /dev/null -w '%{http_code}' --resolve "$host:443:127.0.0.1" "https://$host/")"
    case "$code" in
        401) echo "web      https://$host/ is up, certificate OK, password required (good)";;
        000) echo "web      https://$host/ not ready yet (the free certificate can take a few minutes once the site name points here)"; ok=0;;
        *)   echo "web      https://$host/ answered HTTP $code"; ok=0;;
    esac
else
    echo "web      not set up yet - run: sudo tpa-setup"; ok=0
fi
echo
[[ $ok == 1 ]] && echo "ALL GOOD" || echo "SOMETHING NEEDS ATTENTION (see above)"
[[ $ok == 1 ]]
