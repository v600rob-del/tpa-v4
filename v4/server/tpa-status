#!/bin/bash
# tpa-status - plain-English health check. Shows no keys or passwords.
set -uo pipefail
# Needs admin rights to read the site settings; ask for them by itself.
if [[ $EUID -ne 0 ]]; then exec sudo -n "$0" "$@"; fi
# kit 4.14: where the bus engine answers - its own server (main server), this server's private address (bus server)
ROLE="$(cat /etc/tpa/role 2>/dev/null || echo all)"
BUS_HOST=127.0.0.1
REMOTE_BUS="$(sed -n 's/^TPA_REMOTE_BUS=//p' /etc/tpa/remote.env 2>/dev/null | head -n1)"
[[ "$REMOTE_BUS" =~ ^[0-9.]+$ ]] && BUS_HOST="$REMOTE_BUS"
[[ ! "$REMOTE_BUS" =~ ^[0-9.]+$ && -s /etc/tpa/bus-bind ]] && BUS_HOST="$(cat /etc/tpa/bus-bind)"   # kit 4.15: bus server, or the whole site on it
ok=1
PARTS=(tpa-road tpa-bus tpa-air tpa-rail tpa-stations tpa-hq tpa-web)
[[ "$ROLE" == bus ]] && PARTS=(tpa-bus)
[[ "$ROLE" != bus && "$REMOTE_BUS" =~ ^[0-9.]+$ ]] && PARTS=(tpa-road tpa-air tpa-rail tpa-stations tpa-hq tpa-web)
printf '%-32s %-9s %s\n' "Part" "State" "Memory"
[[ "$ROLE" != bus && "$REMOTE_BUS" =~ ^[0-9.]+$ ]] && printf '%-32s %-9s %s\n' "tpa-bus" "elsewhere" "on its own server ($BUS_HOST)"
for s in "${PARTS[@]}"; do
    st="$(systemctl is-active "$s" 2>/dev/null || true)"
    [[ "$st" == active ]] || ok=0
    mem="$(systemctl show -p MemoryCurrent --value "$s" 2>/dev/null)"
    max="$(systemctl show -p MemoryMax --value "$s" 2>/dev/null)"
    if [[ "$mem" =~ ^[0-9]+$ ]]; then
        if [[ "$max" =~ ^[0-9]+$ ]]; then mem="$((mem / 1048576)) MB of $((max / 1048576)) MB"; else mem="$((mem / 1048576)) MB"; fi
    else mem=""; fi
    printf '%-32s %-9s %s\n' "$s" "$st" "$mem"
done
echo
summary() {  # name port [host]
    local raw
    raw="$(curl -fsS --max-time 3 "http://${3:-127.0.0.1}:$2/status" 2>/dev/null)" || { printf '%-8s no answer\n' "$1"; ok=0; return; }
    printf '%s' "$raw" | python3 -c '
import json, sys
name = sys.argv[1]
d = json.load(sys.stdin)
keep = ("engineVersion", "health", "notice", "loginConfigured", "keyConfigured", "connected", "alwaysOn",
        "trainsTracked", "stationsKnown", "trackMapLoaded", "busesInLastDownload", "busesWithSpeed",
        "reportAgeMedianSeconds", "lastFetchSeconds", "roadMap", "roadMapSource", "roadMapDetail", "roadPathsKnown", "roadPathMs", "mode", "lastError",
        "referenceError", "trackError", "roadMapError", "roadCacheMB", "roadCacheLimitMB", "lastView",
        "stations", "boardsSwitchedOn", "boardRequestsToday", "dailySafetyCap",
        "stopIndex", "stopIndexDetail", "stopIndexError", "boardsMade", "boardsShared", "busStations", "stationsError")
keep2 = ("timetable", "timetableDetail", "timetableUpdate", "timetableError", "replaySeconds", "journeyRound", "replayMemo", "squares", "cpuSeconds")
parts = [f"{k}={d[k]}" for k in keep if k in d and d[k] not in ("", None)]
print(f"{name:8s} " + ", ".join(parts))
tparts = [f"{k}={d[k]}" for k in keep2 if k in d and d[k] not in ("", None)]
if tparts:   # bus 0.6.0: timetables and stops
    print(" " * 9 + ", ".join(tparts))
if isinstance(d.get("timetableMatch"), dict):
    print(" " * 9 + "timetableMatch: " + ", ".join(f"{k}={v}" for k, v in d["timetableMatch"].items() if v is not None))
if d.get("monthlySafetyCap"):   # kit 4.14.4 (owner 3 Nov 19:54): the TomTom allowance, so it cannot creep up unseen
    used, cap = d.get("tomtomRequestsThisMonth") or 0, d["monthlySafetyCap"]
    pct = round(100 * used / cap)
    print(" " * 9 + f"TomTom pictures this month: {used:,} of {cap:,} ({pct}%)" + ("   WARNING: traffic pauses at 100% until next month" if pct >= 80 else ""))
if isinstance(d.get("measure"), dict):   # bus 0.5.9: accuracy figures
    print(" " * 9 + "measure: " + ", ".join(f"{k}={v}" for k, v in d["measure"].items() if v is not None))
' "$1" || { printf '%-8s status unreadable\n' "$1"; ok=0; }
}
if [[ "$ROLE" == bus ]]; then
    summary bus 8781 "$BUS_HOST"; summary stops 8781/stops "$BUS_HOST"; summary busstns 8781/busstations "$BUS_HOST"
    echo; /usr/local/sbin/tpa-update show 2>/dev/null || true; echo
    [[ $ok == 1 ]] && echo "ALL GOOD (bus-only server)" || echo "SOMETHING NEEDS ATTENTION (see above)"
    [[ $ok == 1 ]]; exit
fi
summary road 8782; summary bus 8781 "$BUS_HOST"; summary stops 8781/stops "$BUS_HOST"   # kit 4.21: bus stop boards (bus engine)
summary busstns 8781/busstations "$BUS_HOST"   # kit 4.22: bus stations (bus engine)
summary air 8783; summary rail 8784; summary stations 8785
echo
# server kit 4.11: which version each layer runs, and which are frozen (signed off)
if [[ -x /usr/local/sbin/tpa-update ]]; then /usr/local/sbin/tpa-update show 2>/dev/null || true; echo; fi
code="$(curl -s --max-time 3 -o /dev/null -w '%{http_code}' -H 'Host: 127.0.0.1:8778' http://127.0.0.1:8778/api/v4/manifest)"
printf '%-8s %s\n' "hq" "manifest HTTP $code"
[[ "$code" == 200 ]] || ok=0
host="$(sed -n 's/^TPA_HOST="\(.*\)"$/\1/p' /etc/tpa/web.env 2>/dev/null)"
if [[ -n "$host" ]]; then
    code="$(curl -s --max-time 8 -o /dev/null -w '%{http_code}' --resolve "$host:443:127.0.0.1" "https://$host/")"
    case "$code" in
        401) echo "web      https://$host/ is up, certificate OK, password required (good)";;
        000) echo "web      https://$host/ not ready yet (the free certificate can take a few minutes once the site name points here)"; ok=0;;
        *)   echo "web      https://$host/ answered HTTP $code"; ok=0;;
    esac
else
    echo "web      not set up yet - run: sudo tpa-setup"; ok=0
fi
echo
[[ $ok == 1 ]] && echo "ALL GOOD" || echo "SOMETHING NEEDS ATTENTION (see above)"
[[ $ok == 1 ]]
