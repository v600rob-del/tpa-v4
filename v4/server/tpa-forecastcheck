#!/usr/bin/env python3
"""tpa-forecastcheck - forecast plan Stage 2 (Rob 14 Nov 2026 19:58: "Yes, after the route files"). LOOK-ONLY: reads the
published bus tiles on this server, writes nothing, changes nothing.

How good is the forecast? Every 10 s it reads the street tiles over a few areas, as the map page does. Each time a bus
sends a NEW report, it asks: using only what had been published BEFORE that report, where would each way of showing the
bus have put it at that moment - and how far was that from where the bus really was?
  - forecast:               the bus's forecast `f` (bus 0.22.0 on): timetable pace from how late it is
  - forecast, cautious N s: the same, as if the bus were N seconds later (fewer buses shown ahead, for Stage 3)
  - stay put:               where it last reported
  - carry on at its speed:  on along its route at the speed between its last two reports
  - today's map:            where today's map shows it then (its replay, `d` seconds behind)
24 Nov 2026 21:52 (Rob agreed: make the guess itself better, measured first) - four more ways, each using only what had
been published before the report:
  - own pace, last 3 min:   on along its route at its own average pace over its last 3 minutes of reports (stops and
                            lights included)
  - route pace, last 15 min: on at the typical pace of every bus seen on the same route line over the last 15 minutes
  - forecast at own pace:   the forecast, sped up or slowed to this bus's own recent pace against the forecast's pace
  - forecast + own pace:    half way between the forecast and its own pace
24 Nov 22:30 (bus 0.29.0, scored before it is installed): one more way, and a count of fades:
  - bent path (cautious 15 s): what bus 0.29.0 would publish - each new forecast made cautious, then bent from the path
                            before it (the copy below of engines/bus/forecast.py's cautious/bend; tests keep them the same)
  - fades: at each new forecast, would today's page rules (bus-replay.js forecastMarks: wait at most 20 s when ahead,
    catch up at most 40% faster within 30 s when behind) fade the bus - with today's forecasts, and with bent paths?
  - fair comparison (24 Nov 22:55): what the page would really be showing at the moment of each report, using only the
    forecast or bent path that had APPEARED in the tiles by then (the rows above score a forecast from its report time,
    before it was published - flattering today's forecast in the first minute)
  - settings side by side (24 Nov 23:10, first run: bent paths fade 1% instead of 42% but 158 m out instead of 122 m):
    each setting is played on the same forecasts; fades are counted as the page would meet the new path 10 s after it
    is made (the page reads every 10 s - the worst case)
  NB once bus 0.29.0 is installed the tiles already carry bent paths: "forecast" then IS the bent path.
Distances are metres along the bus's route line. "Ahead" = shown further along than it really was (looks worse than
behind: a bus that runs ahead then slides back). Split by how long after the bus's last report (the page shows a bus
for a minute or more after it), and by area for the forecast.

  sudo python3 -B -u tpa-forecastcheck [--minutes 12] [area ...]
  areas: hull-beverley manchester leeds london-greenwich rural-north-yorkshire (default: all five)
"""
import json
import math
import os
import statistics
import sys
import time
from pathlib import Path

ROOT = Path(os.environ.get('TPA_FORECASTCHECK_DIR', '/run/tpa-bus-tiles')) / 'bus'
SPEED = float(os.environ.get('TPA_FORECASTCHECK_SPEED', '1') or 1)      # tests only: run the clock fast
POLL_S = 10.0
AREAS = {                                         # south, west, north, east
    'hull-beverley': (53.72, -0.47, 53.86, -0.28),
    'manchester': (53.45, -2.28, 53.51, -2.20),
    'leeds': (53.77, -1.60, 53.83, -1.50),
    'london-greenwich': (51.46, 0.00, 51.51, 0.10),
    'rural-north-yorkshire': (54.05, -1.25, 54.25, -0.85),
}
BUCKETS = ((60, 'up to 1 min after its last report'), (120, '1 to 2 min after'), (180, '2 to 3 min after'),
           (300, '3 to 5 min after'))
METHODS = ('forecast', 'bent path (cautious 15 s)', 'forecast, cautious 15 s', 'forecast, cautious 30 s', 'stay put', 'carry on at its speed',
           'own pace, last 3 min', 'route pace, last 15 min', 'forecast at own pace', 'forecast + own pace')
OWN_S = 180.0                                    # 24 Nov: its own pace over this long before its report
ROUTE_S = 900.0                                  # 24 Nov: other buses on the same line over this long
WARP = (0.3, 2.5)                                # the forecast is never sped up or slowed beyond these
CAUTIOUS = (15.0, 30.0)                          # HQ 4.61.0 Stage 3: the same forecast, as if the bus were this much later
KEEP_S = 300.0


def load(p):
    try:
        return json.loads(Path(p).read_text())
    except (OSError, ValueError):
        return None


def along(points, t):
    """Metres at time t on [(time, metres)] (straight between points; before the first / after the last: held)."""
    if t <= points[0][0]:
        return points[0][1]
    for (t0, m0), (t1, m1) in zip(points, points[1:]):
        if t <= t1:
            return m0 + (m1 - m0) * ((t - t0) / (t1 - t0) if t1 > t0 else 1.0)
    return points[-1][1]


# ---- a copy of engines/bus/forecast.py (bus 0.29.0), so this look-only check can run on a server with an older engine
CAUTIOUS_S = 15.0
LEAD_S = 15.0
CATCH_FACTOR = 2.0
CATCH_MIN_EXTRA = 3.0
CATCH_MAX_MPS = 20.0          # ~45 mph
AHEAD_SHARE = 0.35
BEND_JUMP_M = 600.0
BEND_STEP_S = 5.0             # a point every 5 s while easing (a wait still shows as two points at one place)


def along(fc, t: float) -> float:
    """Metres at time t on [(time, metres)]: held before the first point and after the last."""
    if t <= fc[0][0]:
        return float(fc[0][1])
    for (t0, m0), (t1, m1) in zip(fc, fc[1:]):
        if t <= t1:
            return m0 + (m1 - m0) * ((t - t0) / (t1 - t0) if t1 > t0 else 1.0)
    return float(fc[-1][1])


def cautious(fc, wait_s: float = CAUTIOUS_S):
    """The forecast as if the bus were wait_s seconds later: it waits at its report for wait_s, then follows the same
    path that much later."""
    if not fc or len(fc) < 2 or wait_s <= 0:
        return list(fc or [])
    return [tuple(fc[0])] + [(t + wait_s, m) for t, m in fc[1:]]


def bend(prev, target, made_at: float, lead_s: float = LEAD_S, catch_factor: float = CATCH_FACTOR,
         catch_extra: float = CATCH_MIN_EXTRA, catch_max: float = CATCH_MAX_MPS, ahead_share: float = AHEAD_SHARE):
    """The path to publish: `prev` (the path published before, same journey, or None) up to made_at + lead_s, then eased
    onto `target`. Both are [(time, metres)]. Starts at target's first time (the newest report), times always later,
    metres never going back. Without prev, or with a gap over BEND_JUMP_M, it is simply target."""
    if not target or len(target) < 2 or not prev or len(prev) < 2:
        return list(target or [])
    start = float(target[0][0])
    tb = max(float(made_at) + lead_s, start)
    x = along(prev, tb)
    if abs(x - along(target, tb)) > BEND_JUMP_M:
        return list(target)
    out = [(start, along(prev, start))]
    for t, _ in prev:                                   # the old path's own corners between the report and tb
        if start < t < tb:
            out.append((float(t), along(prev, t)))
    if tb > out[-1][0]:
        out.append((tb, x))
    end = float(target[-1][0])
    t, last_kept = tb, tb
    while t < end - 1e-6:
        t1 = min(t + 1.0, end)
        dt = t1 - t
        aim = along(target, t1)
        pace = max(0.0, aim - along(target, t)) / dt      # metres a second
        if x < aim - 0.5:                               # behind: catch up, never past where it should be
            x = min(aim, x + dt * min(max(pace * catch_factor, pace + catch_extra), catch_max))
        elif x > aim + 0.5:                             # ahead: carry on slowly until the forecast reaches it
            x += dt * pace * ahead_share
        else:
            x = aim
        if abs(x - aim) <= 0.5:                         # back on the forecast: from here on it is the forecast
            out.append((t1, x))
            out.extend((float(tt), float(mm)) for tt, mm in target if tt > t1)
            return _tidy(out)
        if t1 - last_kept >= BEND_STEP_S:
            out.append((t1, x))
            last_kept = t1
        t = t1
    if end > out[-1][0]:
        out.append((end, x))
    return _tidy(out)


def _tidy(pts):
    """Times strictly later, metres never going back."""
    out = []
    for t, m in pts:
        if out and t <= out[-1][0]:
            continue
        out.append((t, max(m, out[-1][1]) if out else m))
    return out


# ---- end of the copy


SETTINGS = {                                     # name: (cautious s, lead s, catch factor, catch extra, catch max, ahead share)
    'A as built: cautious 15 s, follows the old path 15 s, catches up at 2x': (15.0, 15.0, 2.0, 3.0, 20.0, 0.35),
    'B no caution, 15 s, 3x': (0.0, 15.0, 3.0, 5.0, 25.0, 0.35),
    'C no caution, 5 s, 3x': (0.0, 5.0, 3.0, 5.0, 25.0, 0.35),
    'D cautious 15 s, 5 s, 3x': (15.0, 5.0, 3.0, 5.0, 25.0, 0.35),
}
PAGE_LATE_S = 10.0


def make_path(prev, fc, now, setting):
    caut, lead, cf, ce, cm, ah = setting
    return bend(prev, cautious(fc, caut) if caut else list(fc), now, lead_s=lead, catch_factor=cf, catch_extra=ce,
                catch_max=cm, ahead_share=ah)


def page_fades(prev, new, now):
    """Would today's page (bus-replay.js forecastMarks) fade a bus moving from path `prev` to path `new` at `now`?"""
    was, want = along(prev, now), along(new, now)
    if was > want + 1:
        tc = next((t0 + (t1 - t0) * (was - m0) / (m1 - m0) for (t0, m0), (t1, m1) in zip(new, new[1:])
                   if m1 >= was and m1 > m0), None)
        return tc is None or tc - now > 20
    if was < want - 1:
        pace = next(((m1 - m0) / max(1e-6, t1 - t0) for (t0, m0), (t1, m1) in zip(new, new[1:]) if t1 > now and m1 > m0), 0.0)
        return (want - was) / (0.4 * max(3.0, pace)) > 30
    return False


def own_pace(rep, t0):
    """24 Nov: metres a second along its line over its last OWN_S seconds of reports up to t0 (stops included); None
    when its reports up to t0 span under a minute."""
    upto = [p for p in rep if p[0] <= t0]
    if len(upto) < 2:
        return None
    first = next((p for p in upto if p[0] >= t0 - OWN_S), upto[0])
    last = upto[-1]
    if last[0] - first[0] < 60:
        first = upto[0]
    if last[0] - first[0] < 60:
        return None
    return max(0.0, (last[1] - first[1]) / (last[0] - first[0]))


class Bus:
    __slots__ = ('line', 'area', 'reports', 'forecasts', 'delay', 'bent', 'appeared', 'tried')

    def __init__(self, line, area):
        self.line, self.area, self.reports, self.forecasts, self.delay = line, area, {}, [], 90
        self.bent = []                              # bus 0.29.0 paths, made as each forecast appeared
        self.tried = {}                             # setting -> the last path made with it
        self.appeared = []                          # [(when it appeared, forecast, bent path)] - the fair comparison


class Check:
    """Everything the check has seen and scored. observe() takes one poll's items; result() makes the copy-back lines."""

    def __init__(self):
        self.buses = {}
        self.errors = {}                            # (method, bucket) -> [signed metres]
        self.today = []                             # today's map: signed metres
        self.by_area = {}                           # area -> [signed metres] (forecast, all times)
        self.scored = 0
        self.with_forecast = 0
        self.lines = {}                             # route line -> [(time, pace m/s)] of every bus on it (24 Nov)
        self.shown = {'today': [], 'bent': []}      # fair comparison: signed metres at each report's moment
        self.trial = {k: {'shown': [], 'fades': 0, 'jumps': 0} for k in SETTINGS}   # settings side by side
        self.fades = {'new forecasts': 0, 'today': 0, 'bent': 0, 'bent put straight on (over 600 m)': 0}

    def observe(self, items, area_of, now=None):
        now = time.time() if now is None else now
        for i, it in items.items():
            if not it.get('s') or not it.get('r'):
                continue
            b = self.buses.get(i)
            if b is None or b.line != it['s']:
                b = self.buses[i] = Bus(it['s'], area_of.get(i, ''))          # new journey (or first seen): start again
            b.delay = it.get('d', b.delay)
            known = max(b.reports) if b.reports else None
            fresh = sorted((float(t), float(m)) for t, m in it['r'] if known is None or t > known)
            for t2, m2 in fresh:
                if known is not None:
                    self.score(b, t2, m2)
                b.reports[t2] = m2
                pace = own_pace(sorted(b.reports.items()), t2)
                if pace is not None:
                    lst = self.lines.setdefault(b.line, [])
                    lst.append((t2, pace))
                    self.lines[b.line] = [x for x in lst if t2 - x[0] <= ROUTE_S + 60]
            f = it.get('f')
            if f and len(f) >= 2 and (not b.forecasts or f[0][0] > b.forecasts[-1][0][0]):
                fc = [(float(t), float(m)) for t, m in f]
                was = b.bent[-1] if b.bent else None
                path = bend(was, cautious(fc), now)
                if was is not None and b.forecasts:
                    self.fades['new forecasts'] += 1
                    self.fades['today'] += page_fades(b.forecasts[-1], fc, now)
                    self.fades['bent'] += page_fades(was, path, now)
                    tb = max(now + LEAD_S, path[0][0])
                    if abs(along(was, tb) - along(cautious(fc), tb)) > BEND_JUMP_M:
                        self.fades['bent put straight on (over 600 m)'] += 1
                tried = {}
                for name, setting in SETTINGS.items():
                    old = b.tried.get(name)
                    new = make_path(old, fc, now, setting)
                    if old is not None and b.forecasts:
                        self.trial[name]['fades'] += page_fades(old, new, now + PAGE_LATE_S)
                        aim = cautious(fc, setting[0]) if setting[0] else fc
                        tb = max(now + setting[1], new[0][0])
                        self.trial[name]['jumps'] += abs(along(old, tb) - along(aim, tb)) > BEND_JUMP_M
                    tried[name] = new
                b.tried = tried
                b.forecasts.append(fc)
                b.bent.append(path)
                b.appeared = (b.appeared + [(now, fc, path, tried)])[-12:]
            newest = max(b.reports)
            b.forecasts = [fc for fc in b.forecasts if newest - fc[0][0] <= KEEP_S]
            b.bent = b.bent[-len(b.forecasts):] if b.forecasts else b.bent[-1:]
            for t in [t for t in b.reports if newest - t > KEEP_S + 600]:
                del b.reports[t]

    def score(self, b, t2, m2):
        """A new report (t2, m2): score what was published before it."""
        self.scored += 1
        had = [x for x in b.appeared if x[0] <= t2]
        if had:
            _, fc, path, tried = had[-1]
            self.shown['today'].append(along(fc, t2) - m2)
            self.shown['bent'].append(along(path, t2) - m2)
            for name, pth in tried.items():
                self.trial[name]['shown'].append(along(pth, t2) - m2)
        rep = sorted(b.reports.items())
        shown = along(rep, t2 - b.delay)            # today's map at t2: the replay, delay seconds behind
        self.today.append(shown - m2)
        for fc in b.forecasts:
            t0, m0 = fc[0]
            h = t2 - t0
            if h <= 0 or h > KEEP_S:
                continue
            bucket = next(k for k, (top, _) in enumerate(BUCKETS) if h <= top)
            before = [p for p in rep if p[0] < t0]
            speed = (m0 - before[-1][1]) / (t0 - before[-1][0]) if before and t0 > before[-1][0] else 0.0
            got = {'forecast': along(fc, t2), 'stay put': m0, 'carry on at its speed': m0 + max(0.0, speed) * h}
            own = own_pace(rep, t0)                 # 24 Nov: what this bus has really been doing
            if own is not None:
                got['own pace, last 3 min'] = m0 + own * h
                ahead = min(OWN_S, max(30.0, h))
                fpace = (along(fc, t0 + ahead) - m0) / ahead
                warp = min(WARP[1], max(WARP[0], own / fpace)) if fpace > 0.3 else 1.0
                got['forecast at own pace'] = m0 + warp * (along(fc, t2) - m0)
                got['forecast + own pace'] = (got['forecast'] + got['own pace, last 3 min']) / 2
            line = [pc for tt, pc in self.lines.get(b.line, []) if t0 - ROUTE_S <= tt <= t0]
            if len(line) >= 3:
                got['route pace, last 15 min'] = m0 + statistics.median(line) * h
            bent = next((p for p in reversed(b.bent) if p[0][0] == t0), None)
            if bent is not None:
                got['bent path (cautious 15 s)'] = along(bent, t2)
            for c in CAUTIOUS:                      # waits at its report for c seconds, then follows the forecast that much later
                got[f'forecast, cautious {c:g} s'] = along(fc, t2 - c) if t2 - c > t0 else m0
            for meth, m in got.items():
                self.errors.setdefault((meth, bucket), []).append(m - m2)
            self.with_forecast += 1
            self.by_area.setdefault(b.area or 'other', []).append(got['forecast'] - m2)

    @staticmethod
    def sums(errs):
        a = sorted(abs(e) for e in errs)
        n = len(a)
        p90 = a[min(n - 1, int(math.ceil(0.9 * n)) - 1)]
        return (f'typical {round(statistics.median(a))} m, 9 in 10 within {round(p90)} m, within 100 m: '
                f'{round(100 * sum(1 for x in a if x <= 100) / n)}%, shown ahead: {round(100 * sum(1 for e in errs if e > 5) / n)}%')

    def result(self):
        out = [f'buses watched {len(self.buses)}, new reports scored {self.scored}, forecasts scored {self.with_forecast} '
               f'(each new report checks every earlier forecast of that bus up to 5 minutes old)']
        if not self.with_forecast:
            out.append('NO FORECASTS IN THE TILES: the bus engine is older than 0.22.0, or its forecast is switched off. '
                       'Only today\'s map was measured.')
        for k, (_, label) in enumerate(BUCKETS):
            rows = [(meth, self.errors.get((meth, k))) for meth in METHODS]
            if not any(r for _, r in rows):
                continue
            out.append(f'{label} (n={len(rows[0][1] or [])}):')
            for meth, errs in rows:
                if errs:
                    out.append(f'   {meth}: {self.sums(errs)}')
        if self.shown['today']:
            out.append(f"what the page would show at each report's moment (only what had appeared by then, n={len(self.shown['today'])}):")
            out.append(f"   today's forecasts: {self.sums(self.shown['today'])}")
            out.append(f"   bent paths: {self.sums(self.shown['bent'])}")
        n = self.fades['new forecasts']
        if n and any(v['shown'] for v in self.trial.values()):
            out.append(f'settings side by side (what the page would show; fades as the page meets each new path {PAGE_LATE_S:g} s late):')
            for name, v in self.trial.items():
                if v['shown']:
                    out.append(f"   {name}: {self.sums(v['shown'])} | fades {v['fades']} of {n} ({round(100 * v['fades'] / n)}%), "
                               f"over 600 m {v['jumps']}")
        if n:
            out.append(f"fades at a new forecast (today's page rules): today's forecasts {self.fades['today']} of {n} "
                       f"({round(100 * self.fades['today'] / n)}%) | bent paths {self.fades['bent']} "
                       f"({round(100 * self.fades['bent'] / n)}%), of which put straight on (over 600 m) "
                       f"{self.fades['bent put straight on (over 600 m)']}")
        if self.today:
            behind = statistics.median(self.today)
            out.append(f"today's map (each report against the replay, shown {round(statistics.median([b.delay for b in self.buses.values()]))} s "
                       f"behind): typical {abs(round(behind))} m {'behind' if behind < 0 else 'ahead'} | {self.sums(self.today)} (n={len(self.today)})")
        if self.by_area:
            out.append('forecast by area (all times): ' + ' | '.join(
                f'{a}: typical {round(statistics.median([abs(e) for e in errs]))} m (n={len(errs)})' for a, errs in sorted(self.by_area.items())))
        return out


def tiles_for(box, size):
    s, w, n, e = box
    dl, dn = size
    return [(r, c) for r in range(math.floor(s / dl), math.floor(n / dl) + 1) for c in range(math.floor(w / dn), math.floor(e / dn) + 1)]


def poll(areas, size):
    items, area_of = {}, {}
    for name, box in areas.items():
        for r, c in tiles_for(box, size):
            for it in load(ROOT / 's' / f'{r}_{c}.json') or []:
                if isinstance(it, dict) and 'i' in it:
                    items[it['i']] = it
                    area_of.setdefault(it['i'], name)
    return items, area_of


def main(argv):
    a = list(argv)
    minutes = 12
    if '--minutes' in a:
        k = a.index('--minutes')
        try:
            minutes = max(1, min(60, int(a[k + 1])))
        except (ValueError, IndexError):
            print('Usage: sudo python3 -B -u tpa-forecastcheck [--minutes 12] [area ...]', flush=True)
            return 2
        del a[k:k + 2]
    bad = [x for x in a if x not in AREAS]
    if bad:
        print('Unknown area: ' + ', '.join(bad) + '. Areas: ' + ' '.join(AREAS), flush=True)
        return 2
    areas = {k: AREAS[k] for k in (a or AREAS)}
    try:
        os.nice(10)                                 # gives way to the engine
    except OSError:
        pass
    print(f'tpa-forecastcheck: look-only, takes about {minutes} minutes. Progress every minute, the result at the end.', flush=True)
    meta = load(ROOT / 'meta.json')
    if not meta or 'small' not in meta:
        print('===== COPY BACK FROM HERE =====\ntpa-forecastcheck: no bus tiles found (is the bus engine publishing?). Nothing was changed.'
              '\n===== COPY BACK TO HERE =====', flush=True)
        return 1
    size = tuple(meta['small'])
    check = Check()
    start, polls, told = time.monotonic(), 0, 0
    while (time.monotonic() - start) / SPEED < minutes * 60:
        items, area_of = poll(areas, size)
        check.observe(items, area_of)
        polls += 1
        minute = int((time.monotonic() - start) / SPEED // 60)
        if minute > told:
            told = minute
            print(f'   minute {minute} of {minutes}: buses watched {len(check.buses)}, new reports scored {check.scored}', flush=True)
        time.sleep(POLL_S * SPEED)
    meta = load(ROOT / 'meta.json') or {}
    print('===== COPY BACK FROM HERE =====', flush=True)
    print(time.strftime('%a %d %b %H:%M:%S UTC', time.gmtime()) + f' | tpa-forecastcheck (look-only), {minutes} min, '
          f'{polls} polls, areas: {" ".join(areas)}', flush=True)
    for line in check.result():
        print(line, flush=True)
    print('Nothing was changed.\n===== COPY BACK TO HERE =====', flush=True)
    return 0


if __name__ == '__main__':
    sys.exit(main(sys.argv[1:]))
