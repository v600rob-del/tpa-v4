#!/usr/bin/env python3
"""tpa-trial - try a new bus engine version on the server against pass marks agreed beforehand, with the way back built in.

Owner 14 Nov 2026 (after a day of installs that failed): every install is a trial. This tool
  1. takes a reading of the engine as it is now (one minute),
  2. installs the new version (sudo tpa-update bus <commit> - only the bus engine restarts),
  3. lets it settle (until it has published a few rounds of tiles, then four more minutes),
  4. takes the same reading again,
  5. compares with the pass marks, and
  6. if any mark is missed - or the new version does not come up at all - puts the version that was running back by
     itself and checks it is running again.
It prints its progress as it goes and one block to copy back.

The trial itself runs detached from the connection that started it: what you see is only a view of its log
(/run/tpa-trial.log). If the connection is lost the trial carries on to the end, including putting the old version back;
`sudo cat /run/tpa-trial.log` shows how it went. Only one trial can run at a time.

  sudo python3 -B -u tpa-trial <new 40-character commit> --expect-version 0.20.4 [--expect-road-mb 800]
        [--max-road-legs 10] [--max-memory-mb 2700] [--max-round-factor 1.2] [--max-tiles-age 45]

  sudo python3 -B -u tpa-trial --reading [--minutes 2]
        LOOK-ONLY: the same one-minute reading the trial takes, as many times as asked, then what the engine's memory is
        made of (limit and highest so far, the RAM disk by folder, route lines held and their measured size).
        Changes and writes nothing.

Pass marks (all must be met, or the old version goes back):
  - the engine answers, says the expected version, and its health is "ready"
  - it is publishing rounds of tiles
  - "road legs" processor-seconds per minute at most --max-road-legs
  - the bus engine's memory at most --max-memory-mb
  - a round of tiles takes no longer than --max-round-factor times what it took before
  - (if given) the road-map memory limit it reports is --expect-road-mb
  - (if given) the published tiles are at most --max-tiles-age seconds old (the page only uses tiles under a minute old)
"""
import json
import os
import signal
import subprocess
import sys
import time
from urllib.request import ProxyHandler, build_opener

LOG = os.environ.get('TPA_TRIAL_LOG', '/run/tpa-trial.log')
LOCK = LOG + '.lock'
SPEED = float(os.environ.get('TPA_TRIAL_SPEED', '1') or 1)          # tests only: 0.01 = a minute passes in 0.6 s
UPDATE = os.environ.get('TPA_TRIAL_UPDATE', '/usr/local/sbin/tpa-update')
LAYER_LINK = os.environ.get('TPA_TRIAL_LAYER_LINK', '/opt/tpa/layers/bus')
BIND_FILE = os.environ.get('TPA_TRIAL_BIND_FILE', '/etc/tpa/bus-bind')
PORT = os.environ.get('TPA_TRIAL_PORT', '8781')
META = os.environ.get('TPA_TRIAL_META', '/run/tpa-bus-tiles/bus/meta.json')
MEMORY_CMD = os.environ.get('TPA_TRIAL_MEMORY_CMD', 'systemctl show -p MemoryCurrent --value tpa-bus')
MEMSTAT = os.environ.get('TPA_TRIAL_MEMSTAT', '/sys/fs/cgroup/system.slice/tpa-bus.service/memory.stat')
SETTLE_ROUNDS = 3
SETTLE_MAX_S = 12 * 60
SETTLE_EXTRA_S = 240
BACK_MAX_S = 10 * 60

OPEN = build_opener(ProxyHandler({})).open          # straight to the engine, never through a proxy
STARTED_FROM = {'commit': ''}                       # the version running when the trial began (the way back)
_T0 = time.monotonic()
_log = None
_stdout_ok = True                       # False in the detached worker: it writes the log only
_log_on = True                          # False in --reading mode: look-only, nothing is written


def now():
    """Seconds since the trial began (tests run the clock fast)."""
    return (time.monotonic() - _T0) / SPEED


def wait(seconds):
    time.sleep(seconds * SPEED)


def say(text=''):
    global _stdout_ok, _log
    if _log_on:
        try:
            if _log is None:
                _log = open(LOG, 'a')
            _log.write(text + '\n')
            _log.flush()
        except OSError:
            pass
    if _stdout_ok:
        try:
            print(text, flush=True)
        except OSError:                  # the connection has gone: carry on, the log has everything
            _stdout_ok = False


def host():
    try:
        h = open(BIND_FILE).read().strip()
        return h or '127.0.0.1'
    except OSError:
        return '127.0.0.1'


def status():
    """The bus engine's own status, or None if it does not answer."""
    try:
        with OPEN(f'http://{host()}:{PORT}/status', timeout=20) as r:
            return json.loads(r.read().decode())
    except Exception:
        return None


def memory_mb():
    try:
        out = subprocess.run(MEMORY_CMD.split(), capture_output=True, text=True, timeout=20).stdout.strip()
        return round(int(out) / 1048576)
    except Exception:
        return None


def memory_parts():
    """What the engine's memory is made of, in MB: (the program itself, files it has read, tiles and other shared
    memory), from the system's own count for the bus service; None if it cannot be read."""
    try:
        st = dict(line.split()[:2] for line in open(MEMSTAT) if len(line.split()) >= 2)
        anon, file, shmem = int(st['anon']), int(st['file']), int(st.get('shmem', 0))
        return round(anon / 1048576), round((file - shmem) / 1048576), round(shmem / 1048576)
    except Exception:
        return None


def tiles_age():
    try:
        return round(time.time() - json.load(open(META))['updatedAt'])
    except Exception:
        return None


def running_commit():
    try:
        return os.path.basename(os.readlink(LAYER_LINK))
    except OSError:
        return ''


def reading(label):
    """One minute of the engine: {version, health, rounds in the minute, last round s, processor-seconds per minute by
    job, memory, road-map memory, tiles age}; None if the engine did not answer."""
    a, ta = status(), now()
    if a is None:
        return None
    say(f'   {label}: measuring for one minute...')
    wait(60)
    b, tb = status(), now()
    if b is None or (b.get('cpuSeconds') or {}).get('engine total', 0) < (a.get('cpuSeconds') or {}).get('engine total', 0):
        return None                      # stopped answering, or restarted in the middle
    mins = max((tb - ta) / 60, 1e-6)
    ca, cb = a.get('cpuSeconds') or {}, b.get('cpuSeconds') or {}
    pa, pb = a.get('publish') or {}, b.get('publish') or {}
    last = pb.get('last') or {}
    return {'version': b.get('engineVersion'), 'health': b.get('health'),
            'rounds': (pb.get('rounds') or 0) - (pa.get('rounds') or 0), 'roundsTotal': pb.get('rounds') or 0,
            'roundSeconds': last.get('wallSeconds'), 'buses': last.get('buses'),
            'cpu': {k: round((cb.get(k, 0) - ca.get(k, 0)) / mins, 1) for k in ('road legs', 'publishing', 'matching', 'engine total')},
            'memoryMB': memory_mb(), 'memoryParts': memory_parts(), 'roadMB': b.get('roadCacheMB'), 'roadLimitMB': b.get('roadCacheLimitMB'),
            'tilesAge': tiles_age(), 'packedKb': last.get('packedKbWritten'), 'largestKb': last.get('largestKb'),
            'forecast': last.get('forecast')}


def show(label, r):
    if r is None:
        return f'{label}: the bus engine did not answer'
    c = r['cpu']
    return (f'{label}: version {r["version"]}, health {r["health"]} | rounds of tiles in the minute: {r["rounds"]}, last round took '
            f'{r["roundSeconds"]} s, tiles {r["tilesAge"]} s old, buses {r["buses"]} | processor-seconds a minute: road legs '
            f'{c["road legs"]}, all publishing {c["publishing"]}, matching {c["matching"]}, engine total {c["engine total"]} | '
            f'memory {r["memoryMB"]} MB'
            + ('' if not r.get('memoryParts') else ' (the program itself {} MB, files it has read {} MB, tiles and other shared memory {} MB)'
               .format(*r['memoryParts']))
            + f', road map {r["roadMB"]} MB (limit {r["roadLimitMB"]} MB) | rounds since it started: {r["roundsTotal"]}'
            + ('' if r.get('packedKb') is None else f' | tiles written last round {r["packedKb"]} KB packed, largest {r["largestKb"]} KB')
            + ('' if not r.get('forecast') else ' | forecast: buses with one {buses}, journeys ready {journeysKept}, waiting {waiting}'
               .format(**{k: r['forecast'].get(k) for k in ('buses', 'journeysKept', 'waiting')})))


def update(commit):
    try:
        r = subprocess.run([UPDATE, 'bus', commit], capture_output=True, text=True, timeout=600)
        for line in (r.stdout + r.stderr).strip().splitlines()[-3:]:
            say('   | ' + line[:200])
        return r.returncode == 0
    except Exception as exc:
        say(f'   | the update command itself failed: {type(exc).__name__}: {str(exc)[:150]}')
        return False


def settle(want_version, max_s, rounds=SETTLE_ROUNDS):
    """Wait until the engine answers with this version and has published `rounds` rounds; True if it did in time."""
    start = now()
    told = -1
    while now() - start < max_s:
        s = status()
        done = ((s or {}).get('publish') or {}).get('rounds') or 0
        if s is not None and s.get('engineVersion') == want_version and done >= rounds:
            return True
        minute = int((now() - start) // 60)
        if minute != told:
            told = minute
            what = 'not answering yet' if s is None else f'version {s.get("engineVersion")}, rounds of tiles so far: {done} of {rounds}'
            say(f'   settling, minute {minute + 1} (up to {max_s // 60}): {what}')
        wait(15)
    return False


def trial(argv):
    """The trial itself (runs detached; everything goes to the log)."""
    a = list(argv)

    def opt(name, default=None, kind=str):
        if name in a:
            k = a.index(name)
            v = a[k + 1]
            del a[k:k + 2]
            return kind(v)
        return default
    expect_version = opt('--expect-version')
    expect_road = opt('--expect-road-mb', None, int)
    max_legs = opt('--max-road-legs', 10.0, float)
    max_mem = opt('--max-memory-mb', 2700, int)
    max_factor = opt('--max-round-factor', 1.2, float)
    max_age = opt('--max-tiles-age', None, int)
    new = a[0] if a else ''
    if len(a) != 1 or len(new) != 40 or any(ch not in '0123456789abcdef' for ch in new) or not expect_version:
        say('Usage: sudo python3 -B -u tpa-trial <new 40-character commit> --expect-version <version> [--expect-road-mb N] '
            '[--max-road-legs 10] [--max-memory-mb 2700] [--max-round-factor 1.2] [--max-tiles-age 45]   |   look-only: '
            'sudo python3 -B -u tpa-trial --reading [--minutes 2]')
        return 2
    old = running_commit()
    say(f'tpa-trial: about 12 to 20 minutes; up to 35 if the old version has to go back. Progress shows below, the result '
        f'comes at the end. (If this connection drops, the trial carries on by itself: sudo cat {LOG})')
    lines = []                           # the block to copy back

    def finish(verdict, code):
        say('===== COPY BACK FROM HERE =====')
        say(time.strftime('%a %d %b %H:%M:%S UTC', time.gmtime()) + ' | tpa-trial')
        for line in lines:
            say(line)
        say(verdict)
        say('===== COPY BACK TO HERE =====')
        return code

    STARTED_FROM['commit'] = old if len(old) == 40 else ''
    if len(old) != 40:
        lines.append('Could not tell which bus version is running now, so there would be no way back.')
        return finish('RESULT: NOTHING WAS CHANGED.', 1)
    if old == new:
        lines.append(f'The bus engine is already running {new}.')
        return finish('RESULT: NOTHING WAS CHANGED.', 1)

    say('Step 1 of 5: reading the engine as it is now...')
    before = reading('before')
    lines.append(show('BEFORE', before))
    if before is None:
        return finish('RESULT: NOTHING WAS CHANGED (the engine must be answering before a trial starts).', 1)
    lines.append(f'Way back: {old} (version {before["version"]})')

    say(f'Step 2 of 5: installing {new[:8]}... (only the bus engine restarts)')
    installed = update(new)
    failed = []
    after = None
    if not installed and running_commit() == old:
        s = status()
        lines.append('The update did not go in; the version that was running is still in place'
                     + ('.' if s is not None and s.get('engineVersion') == before['version'] else ', BUT IT IS NOT ANSWERING - please tell Claude.'))
        return finish('RESULT: THE UPDATE DID NOT GO IN. NOTHING WAS CHANGED.', 1)
    if not installed or running_commit() != new:
        failed.append('the update did not go in cleanly')
    else:
        say(f'Step 3 of 5: letting it settle (until it has published {SETTLE_ROUNDS} rounds of tiles, then 4 more minutes)...')
        if not settle(expect_version, SETTLE_MAX_S):
            s = status()
            failed.append('the engine did not answer after the install' if s is None else
                          f'after {SETTLE_MAX_S // 60} minutes it had not published {SETTLE_ROUNDS} rounds of tiles as version {expect_version} '
                          f'(it says version {s.get("engineVersion")}, rounds {((s.get("publish") or {}).get("rounds"))})')
        else:
            extra = SETTLE_EXTRA_S // 60
            for minute in range(extra):
                say(f'   settled; running on before the reading, minute {minute + 1} of {extra}...')
                wait(60)
            say('Step 4 of 5: reading the new version...')
            after = reading('after')
            lines.append(show('AFTER ', after))
            if after is None:
                failed.append('the engine stopped answering during the reading')
            else:
                marks = [
                    (after['version'] == expect_version, f'version is {expect_version}', f'{after["version"]}'),
                    (after['health'] == 'ready', 'health is ready', f'{after["health"]}'),
                    (after['rounds'] >= 1, 'publishing rounds of tiles (at least 1 in the minute)', f'{after["rounds"]}'),
                    (after['cpu']['road legs'] <= max_legs, f'road legs at most {max_legs:g} processor-seconds a minute',
                     f'{after["cpu"]["road legs"]} (before: {before["cpu"]["road legs"]})'),
                    (after['memoryMB'] is not None and after['memoryMB'] <= max_mem, f'memory at most {max_mem} MB', f'{after["memoryMB"]} MB'),
                ]
                if before['roundSeconds'] and after['roundSeconds'] is not None:
                    marks.append((after['roundSeconds'] <= max_factor * before['roundSeconds'],
                                  f'a round takes no longer than {max_factor:g} x before ({before["roundSeconds"]} s)', f'{after["roundSeconds"]} s'))
                if expect_road is not None:
                    marks.append((after['roadLimitMB'] == expect_road, f'road-map memory limit is {expect_road} MB', f'{after["roadLimitMB"]} MB'))
                if max_age is not None:
                    marks.append((after['tilesAge'] is not None and after['tilesAge'] <= max_age, f'tiles at most {max_age} s old',
                                  f'{after["tilesAge"]} s'))
                for ok, what, got in marks:
                    lines.append(f'   {"PASS" if ok else "MISSED"}: {what} - measured {got}')
                    if not ok:
                        failed.append(what)
    if not failed:
        say('Step 5 of 5: every pass mark met - the new version stays.')
        return finish(f'RESULT: EVERY PASS MARK MET. The new version ({expect_version}, {new}) is running and STAYS.', 0)

    lines.append('Not met: ' + '; '.join(failed))
    say(f'Step 5 of 5: pass marks missed - putting the old version ({old[:8]}...) back...')
    update(old)
    back = running_commit() == old and settle(before['version'], BACK_MAX_S, rounds=1)
    s = status()
    lines.append('AFTER GOING BACK: ' + ('the bus engine is not answering' if s is None else
                 f'version {s.get("engineVersion")}, health {s.get("health")}, rounds of tiles so far {((s.get("publish") or {}).get("rounds"))}'))
    if back:
        return finish(f'RESULT: PASS MARKS MISSED. The old version ({before["version"]}, {old}) was PUT BACK and is running.', 3)
    return finish(f'RESULT: PASS MARKS MISSED, AND THE OLD VERSION IS NOT CONFIRMED RUNNING. Please tell Claude straight away. '
                  f'To put it back by hand: sudo tpa-update bus {old}', 4)


def worker(argv):
    try:
        return trial(argv)
    except Exception as exc:
        import traceback
        say('===== COPY BACK FROM HERE =====')
        say('tpa-trial STOPPED WITH AN ERROR: ' + type(exc).__name__ + ': ' + str(exc)[:200])
        for line in traceback.format_exc().strip().splitlines()[-6:]:
            say('   ' + line)
        was = STARTED_FROM['commit']
        if was and running_commit() != was:          # never leave an untried version running after an error
            say(f'Putting the version that was running back ({was})...')
            try:
                update(was)
            except Exception:
                pass
        say(f'The bus engine is running: {running_commit()}' + (f' (the trial began from {was})' if was else ''))
        say('===== COPY BACK TO HERE =====')
        return 5


# ---------------------------------------------------------------- what the memory is made of (14 Nov 2026, 19:31)
# Memory reached 2,993 of 3,072 MB at 19:20 and the limit went to 6 GB. Before choosing any permanent limit, measure WHAT
# is growing. Everything here only reads: the system's own files for the bus service, the engine's own status answers,
# and the RAM disk (whose files count against the engine's memory). Limits below are the engine's settings (bus_engine.py
# SHAPES_KEEP, GEN_KEEP, STOP_KERB_KEEP; the server does not change them).
LINES_KEEP, DRAWN_KEEP, KERB_KEEP = 20000, 15000, 300000
POINT_BYTES = 40                         # a route line holds 5 numbers of 8 bytes for each point (replay.Shape)
SAMPLE_FILES = 1000                      # route files measured of each kind (timetable / drawn by TPA)


def _ask(path):
    try:
        with OPEN(f'http://{host()}:{PORT}{path}', timeout=20) as r:
            return json.loads(r.read().decode())
    except Exception:
        return None


def _read(path):
    try:
        return open(path).read().strip()
    except OSError:
        return None


def _mb(n):
    return round(n / 1048576)


def _engine_line():
    cg = os.path.dirname(MEMSTAT)
    parts = []
    pids = [p for p in (_read(os.path.join(cg, 'cgroup.procs')) or '').split() if p.isdigit()]
    best = None
    for pid in pids:                     # the engine is the oldest process in its group (builders come and go)
        stat = _read(f'/proc/{pid}/stat')
        if stat:
            try:
                start = int(stat.rsplit(')', 1)[1].split()[19])
            except (IndexError, ValueError):
                continue
            if best is None or start < best[1]:
                best = (pid, start)
    if best:
        try:
            up = float(open('/proc/uptime').read().split()[0]) - best[1] / os.sysconf('SC_CLK_TCK')
            threads = next((ln.split()[1] for ln in open(f'/proc/{best[0]}/status') if ln.startswith('Threads:')), '?')
            parts.append(f'running for {int(up // 3600)} h {int(up % 3600 // 60)} min, {threads} threads')
        except (OSError, ValueError):
            parts.append('running time not readable')
    else:
        parts.append('running time not readable')
    limit, peak = _read(os.path.join(cg, 'memory.max')), _read(os.path.join(cg, 'memory.peak'))
    if limit and limit.isdigit():
        parts.append(f'memory limit {_mb(int(limit))} MB' + (f', highest so far {_mb(int(peak))} MB' if peak and peak.isdigit() else ''))
    elif limit == 'max':
        parts.append('no memory limit set')
    else:
        parts.append('memory limit not readable')
    return 'engine: ' + ' | '.join(parts)


def _ramdisk(root, build):
    """{folder label: [bytes, files]} for the published tiles' folder, and the route files of each timetable build."""
    sizes, total = {}, 0
    route_files = {}
    for here, dirs, files in os.walk(root):
        rel = os.path.relpath(here, root).split(os.sep)
        if rel[0] in ('s', 'b'):
            key = 'small tiles' if rel[0] == 's' else 'big tiles'
        elif rel[0] == 'routes' and len(rel) >= 2:
            key = ('route lines for timetable ' if rel[1] == build else 'route lines for an OLDER timetable ') + rel[1]
        else:
            key = None
        for name in files:
            try:
                st = os.lstat(os.path.join(here, name))
            except OSError:
                continue
            used = st.st_blocks * 512
            total += used
            if key:
                got = sizes.setdefault(key, [0, 0])
                got[0] += used
                if name.endswith('.json'):
                    got[1] += 1
                    if rel[0] == 'routes' and rel[1] == build:
                        route_files.setdefault('drawn' if name.startswith('g-') else 'timetable', []).append(os.path.join(here, name))
    return total, sizes, route_files


def _average_points(paths):
    if not paths:
        return None, 0
    paths = sorted(paths)
    step = max(1, len(paths) // SAMPLE_FILES)
    counts = []
    for p in paths[::step][:SAMPLE_FILES]:
        try:
            text = open(p).read()
        except OSError:
            continue
        counts.append(text.count('],[') + 1 if '[[' in text else 0)
    return (round(sum(counts) / len(counts)) if counts else None), len(counts)


def memory_detail(s):
    """Lines for the copy-back block: what the engine's memory is made of. Look-only."""
    out = ['MEMORY DETAIL (look-only):', '   ' + _engine_line()]
    root = os.path.dirname(META)
    try:
        build = str(json.load(open(META)).get('build') or '')
    except Exception:
        build = ''
    if not build:
        try:
            build = max((n for n in os.listdir(os.path.join(root, 'routes')) if n.isdigit()), key=int, default='')
        except OSError:
            build = ''
    total, sizes, route_files = _ramdisk(root, build) if os.path.isdir(root) else (0, {}, {})
    if sizes or total:
        order = sorted(sizes, key=lambda k: (('small tiles', 'big tiles').index(k) if k.endswith('tiles') else 2 + ('OLDER' in k), k))
        out.append('   RAM disk (counts against the engine): all ' + str(_mb(total)) + ' MB | ' + ' | '.join(
            f'{k}: {_mb(sizes[k][0])} MB ({sizes[k][1]} lines)' if k.startswith('route') else f'{k} {_mb(sizes[k][0])} MB ({sizes[k][1]} tiles)'
            for k in order))
    else:
        out.append('   RAM disk: not found')
    s = s or {}
    kept, drawn = s.get('routeLinesKept'), s.get('drawnLines') or {}
    last = (s.get('publish') or {}).get('last') or {}
    written = last.get('routeLines')
    removed = '' if last.get('routeFilesRemoved') is None else f" (removed so far {last['routeFilesRemoved']})"
    out.append(f"   route lines held in the engine's memory: from the timetable {kept} (limit {LINES_KEEP}), drawn by TPA "
               f"{drawn.get('linesKept')} (limit {DRAWN_KEEP}), waiting to be drawn {drawn.get('waiting')} | route-line files kept {written}{removed}")
    tt_avg, n1 = _average_points(route_files.get('timetable'))
    dr_avg, n2 = _average_points(route_files.get('drawn'))
    if n1 + n2 == 0:
        out.append('   average size: no route files to measure')
    else:
        a, b = tt_avg if tt_avg is not None else dr_avg, dr_avg if dr_avg is not None else tt_avg
        est = ((kept or 0) * a + (drawn.get('linesKept') or 0) * b) * POINT_BYTES
        out.append(f'   average size (measured on {n1 + n2} route files): timetable lines {tt_avg if tt_avg is not None else "none"} points, '
                   f'lines drawn by TPA {dr_avg if dr_avg is not None else "none"} points -> the route lines held come to about '
                   f'{_mb(est)} MB (estimate at {POINT_BYTES} bytes a point)')
    stops = _ask('/stops/status') or {}
    kerb = (stops.get('stopsOnKerb') or {}).get('kept')
    out.append(f"   also remembered: stops placed on the kerb {kerb} (limit {KERB_KEEP}), buses' drawings {(s.get('sharing') or {}).get('busesKept')}")
    return out


def look(argv):
    """--reading: one-minute readings of the engine as it is. Look-only: nothing is changed and nothing is written."""
    global _log_on
    _log_on = False
    try:
        os.nice(10)                      # a reading gives way to the engine (it measures the engine's own counters)
    except OSError:
        pass
    minutes = 2
    if '--minutes' in argv:
        try:
            minutes = max(1, min(30, int(argv[argv.index('--minutes') + 1])))
        except (ValueError, IndexError):
            print('Usage: sudo python3 -B -u tpa-trial --reading [--minutes 2]', flush=True)
            return 2
    say(f'tpa-trial --reading: look-only, takes about {minutes} minute{"s" if minutes != 1 else ""}. Progress shows below, the result comes at the end.')
    lines = [f'Running now: {running_commit() or "unknown"}']
    ok = True
    for k in range(minutes):
        say(f'Reading {k + 1} of {minutes}...')
        r = reading(f'reading {k + 1}')
        lines.append(show(f'READING {k + 1}', r))
        if r is None:
            ok = False
            break
    if ok:
        say('Looking at what the memory is made of (a few seconds)...')
        try:
            lines.extend(memory_detail(status()))
        except Exception as exc:           # the readings above still count
            lines.append(f'MEMORY DETAIL could not be read: {type(exc).__name__}: {str(exc)[:150]}')
    say('===== COPY BACK FROM HERE =====')
    say(time.strftime('%a %d %b %H:%M:%S UTC', time.gmtime()) + ' | tpa-trial --reading (look-only)')
    for line in lines:
        say(line)
    say('Nothing was changed.')
    say('===== COPY BACK TO HERE =====')
    return 0 if ok else 1


def main(argv):
    """Start the trial detached from this connection, then show its log as it grows until it has finished."""
    global _stdout_ok, _log
    if '--reading' in argv:
        return look(argv)
    import fcntl
    lock = open(LOCK, 'w')
    try:
        fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except OSError:
        print(f'A trial is already running. To see how it is going: sudo cat {LOG}', flush=True)
        return 6
    open(LOG, 'w').close()               # a fresh log for this trial
    pid = os.fork()
    if pid == 0:                         # the trial: its own session, no ties to the connection
        os.setsid()
        signal.signal(signal.SIGHUP, signal.SIG_IGN)
        null = os.open(os.devnull, os.O_RDWR)
        for fd in (0, 1, 2):
            os.dup2(null, fd)
        _stdout_ok = False
        code = 5
        try:
            code = worker(argv)
        finally:
            os._exit(code)
    lock.close()                         # the trial holds the lock from here
    code = 0
    try:
        with open(LOG, 'rb') as view:
            pending = b''
            while True:
                chunk = view.read()
                if chunk:
                    pending += chunk
                    *whole, pending = pending.split(b'\n')
                    for line in whole:
                        print(line.decode('utf-8', 'replace'), flush=True)
                    continue
                done, st = os.waitpid(pid, os.WNOHANG)
                if done:
                    rest = pending + view.read()
                    for line in rest.decode('utf-8', 'replace').splitlines():
                        print(line, flush=True)
                    code = os.waitstatus_to_exitcode(st)
                    break
                time.sleep(0.2 if SPEED == 1 else 0.02)
    except OSError:                      # this connection has gone; the trial itself carries on
        return 7
    return code


if __name__ == '__main__':
    sys.exit(main(sys.argv[1:]))
