#!/usr/bin/env python3
"""tpa-air-types: look-only count of plane types (asks only TPA's own plane engine on this server - no requests to
FlyItalyADSB or anyone else). Since air 0.8.1 the engine keeps a daily count (each plane once a day, 21 days);
this prints the last 14 days, busiest first, and which types already have their own box picture. Prints COPY markers."""
import json
import sys
import urllib.request

BASE = 'http://127.0.0.1:8783'
OPEN = urllib.request.build_opener(urllib.request.ProxyHandler({})).open
days = int(sys.argv[1]) if len(sys.argv) > 1 and sys.argv[1].isdigit() else 14

print('=========== COPY FROM HERE ===========')
try:
    with OPEN(f'{BASE}/types?days={days}', timeout=10) as r:
        rep = json.loads(r.read())
except Exception as exc:
    print('  The plane engine has no daily count yet (needs air 0.8.1):', type(exc).__name__)
    rep = None
if rep:
    print(f"Days counted: {len(rep['days'])} ({rep['days'][0]} to {rep['days'][-1]})" if rep['days'] else 'No days counted yet')
    for d in rep['days']:
        print(f"  {d}: {rep['planesPerDay'][d]} different planes")
    print('Types (busiest first): code  planes  picture  name')
    for t in rep['types'][:70]:
        print(f"  {t['code']:6} {t['count']:6}  {(t['picture'] or '-'):8} {t['name'][:40]}")
print('=========== COPY TO HERE ===========')
