#!/usr/bin/env python3
"""TPA look-only: recognition problems in every plane's box, right now.
(Rob 19 Nov 2026 13:40, a CV-22 Osprey shown as "V22", "Military helicopter", a Chinook picture and flight "00000000":
"We are still getting a few recognition issues ... with this seperate site being for enthusiasts I want to get this bit
more detailed".) Reads only TPA's own air engine (127.0.0.1:8783): every plane over the UK once, and its box.
Plus ONE FlyItalyADSB request to count which fields planes send; changes nothing. Run: curl ... | sudo python3 -"""
import collections
import json
import re
import urllib.request

ENGINE = 'http://127.0.0.1:8783'
LATS, LONS = (49.5, 52.0, 54.5, 61.0), (-8.5, -4.8, -1.2, 2.5)


def get(path):
    with urllib.request.urlopen(ENGINE + path, timeout=10) as r:
        return json.loads(r.read())


ents = {}
for s, n in zip(LATS, LATS[1:]):
    for w, e in zip(LONS, LONS[1:]):
        for x in get(f'/snapshot?west={w}&south={s}&east={e}&north={n}').get('entities') or []:
            ents[x['id']] = x
print(f'Planes over the UK: {len(ents)}. Reading every box...', flush=True)

problems = collections.defaultdict(list)
bare_codes = collections.Counter()
no_type = 0
pictures = collections.Counter()
mil = 0
for pid, ent in ents.items():
    d = get('/details?id=' + pid)
    r = {x.get('label'): x.get('value') for x in d.get('rows') or []}
    code = (r.get('Type code') or '').upper()
    name = r.get('Aircraft') or ''
    call = (r.get('Flight') or '').split(' (')[-1].rstrip(')')
    kind = r.get('Kind') or ''
    military = 'ilitary' in kind or (ent.get('variant') or '').startswith('mil') or ent.get('variant') == 'military'
    mil += military
    tag = f"{(ent.get('label') or '').split(' · ')[0][:14]:14s} {code or '-':5s} {name[:34]:34s}"
    if not code:
        no_type += 1
    if code and (not name or name.upper() == code):
        bare_codes[code] += 1
        problems['name is only the type code' + (' (military)' if military else '')].append(tag)
    if call and (re.fullmatch(r'(.)\1{3,}', call) or not re.fullmatch(r'[A-Z0-9-]{2,10}', call) or call.isdigit() and len(call) > 6):
        problems['junk callsign shown as the flight'].append(tag + f'  flight "{call}"')
    if military and not r.get('Operator'):
        problems['military with no operator'].append(tag + f"  reg {r.get('Registration', '-')}  ICAO {r.get('ICAO code', '')}")
    if code in ('V22',) and 'helicopter' in kind.lower():
        problems['tiltrotor called a helicopter'].append(tag)
    pic = 'own picture of the type' if d.get('photo') else ('kind picture: ' + (d.get('picture') or 'none'))
    pictures[pic if pic.startswith('own') else 'kind picture'] += 1
    if military and not d.get('photo'):
        problems['military, kind picture only (no picture of its type)'].append(tag + f"  picture {d.get('picture') or '-'}")

print(f'\nMilitary: {mil}.  No type code at all: {no_type}.  Box pictures: ' +
      ', '.join(f'{k} {v}' for k, v in pictures.most_common()))
for what, rows in sorted(problems.items(), key=lambda kv: -len(kv[1])):
    print(f'\n{what}: {len(rows)}')
    for row in rows[:25]:
        print('   ' + row)
    if len(rows) > 25:
        print(f'   ... and {len(rows) - 25} more')
print('\nType codes shown with no name (most planes first):')
print('   ' + ', '.join(f'{c} x{n}' for c, n in bare_codes.most_common(60)))
# What extra fields do planes send (for an enthusiasts' box)? One FlyItalyADSB request (key from /etc/tpa/air.env, never
# printed): of the month's 300,000.
try:
    key = ''
    for line in open('/etc/tpa/air.env', encoding='utf8'):
        m = re.match(r'\s*TPA_FLYITALY_API_KEY\s*=\s*"?([^"\s]+)', line)
        if m:
            key = m.group(1)
    req = urllib.request.Request('https://api.flyitalyadsb.com/api/aircraft/v2/lat/52.3/lon/-2.2/dist/250/',
                                 headers={'X-Api-Key': key, 'Accept': 'application/json',
                                          'User-Agent': 'TPA-plane-check-look (+mailto:tpaprojectuk@gmail.com)'})
    with urllib.request.urlopen(req, timeout=20) as r:
        ac = json.loads(r.read()).get('ac') or []
    have = collections.Counter(k for a in ac for k, v in a.items() if v not in (None, '', []))
    print(f'\nFields planes send (of {len(ac)} planes in the England circle):')
    print('   ' + ', '.join(f'{k} {100 * n // max(1, len(ac))}%' for k, n in sorted(have.items(), key=lambda kv: -kv[1])))
    mils = [a for a in ac if int(a.get('dbFlags') or 0) & 1]
    if mils:
        hm = collections.Counter(k for a in mils for k, v in a.items() if v not in (None, '', []))
        print(f'   military ({len(mils)}): ' + ', '.join(f'{k} {100 * n // len(mils)}%' for k, n in sorted(hm.items(), key=lambda kv: -kv[1])))
except Exception as exc:
    print('\n(field count skipped:', type(exc).__name__, getattr(exc, 'code', ''), ')')
print('\nDone. Nothing was changed (one plane-data request was made).')
