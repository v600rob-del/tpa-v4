#!/usr/bin/env python3
"""tpa-road-probe: look-only test of TomTom incident tiles (about 7 small requests). Prints COPY markers.
Run on the server:  sudo python3 tpa-road-probe   (reads the TomTom key from /etc/tpa/road.env; never prints it)"""
print('=========== COPY FROM HERE ===========')
print('TomTom incident test (look-only, about 7 small requests)')
import os
KEY = ''
for line in open('/etc/tpa/road.env'):
    if line.startswith('TOMTOM_API_KEY='):
        KEY = line.split('=', 1)[1].strip()
        if KEY.startswith('"') and KEY.endswith('"'):
            KEY = KEY[1:-1].replace('\\"', '"').replace('\\\\', '\\')
os.environ['TT_KEY'] = KEY
import gzip
import struct


def _varint(b, i):
    r = s = 0
    while True:
        c = b[i]; i += 1
        r |= (c & 0x7F) << s
        if c < 0x80:
            return r, i
        s += 7
        if s > 63:
            raise ValueError('bad-varint')


def _fields(b):
    i, n = 0, len(b)
    while i < n:
        key, i = _varint(b, i)
        f, t = key >> 3, key & 7
        if t == 0:
            v, i = _varint(b, i)
        elif t == 1:
            v = b[i:i + 8]; i += 8
        elif t == 2:
            ln, i = _varint(b, i); v = b[i:i + ln]; i += ln
        elif t == 5:
            v = b[i:i + 4]; i += 4
        else:
            raise ValueError('bad-wire-type')
        if i > n:
            raise ValueError('truncated')
        yield f, t, v


def _packed(b):
    out, i = [], 0
    while i < len(b):
        v, i = _varint(b, i); out.append(v)
    return out


def _zz(n):
    return (n >> 1) ^ -(n & 1)


def _value(b):
    for f, t, v in _fields(b):
        if f == 1: return v.decode('utf-8', 'replace')
        if f == 2: return struct.unpack('<f', v)[0]
        if f == 3: return struct.unpack('<d', v)[0]
        if f in (4, 5): return v if f == 5 or v < (1 << 63) else v - (1 << 64)
        if f == 6: return _zz(v)
        if f == 7: return bool(v)
    return None


def _geometry(cmds):
    parts, cur, x, y, i = [], [], 0, 0, 0
    while i < len(cmds):
        c = cmds[i]; i += 1
        cid, cnt = c & 7, c >> 3
        if cid in (1, 2):
            for _ in range(cnt):
                if i + 1 >= len(cmds):
                    break
                x += _zz(cmds[i]); y += _zz(cmds[i + 1]); i += 2
                if cid == 1 and cur:
                    parts.append(cur); cur = []
                cur.append((x, y))
        elif cid == 7:
            pass
        else:
            break
    if cur:
        parts.append(cur)
    return parts


def read_tile(raw):
    """{layer name: {'extent': int, 'features': [{'id', 'type', 'props', 'parts'}]}}"""
    if raw[:2] == b'\x1f\x8b':
        raw = gzip.decompress(raw)
    layers = {}
    for f, t, v in _fields(raw):
        if f != 3 or t != 2:
            continue
        name, extent, keys, values, feats = '', 4096, [], [], []
        for lf, lt, lv in _fields(v):
            if lf == 1: name = lv.decode('utf-8', 'replace')
            elif lf == 5: extent = lv
            elif lf == 3: keys.append(lv.decode('utf-8', 'replace'))
            elif lf == 4: values.append(_value(lv))
            elif lf == 2: feats.append(lv)
        out = []
        for fb in feats:
            fid, tags, gtype, geom = None, [], 0, []
            for ff, ft, fv in _fields(fb):
                if ff == 1: fid = fv
                elif ff == 2: tags = _packed(fv)
                elif ff == 3: gtype = fv
                elif ff == 4: geom = _packed(fv)
            props = {}
            for k in range(0, len(tags) - 1, 2):
                if tags[k] < len(keys) and tags[k + 1] < len(values):
                    props[keys[tags[k]]] = values[tags[k + 1]]
            out.append({'id': fid, 'type': gtype, 'props': props, 'parts': _geometry(geom)})
        layers[name] = {'extent': extent, 'features': out}
    return layers
import json, math, os, sys, time, urllib.request, urllib.error
from collections import Counter
KEY = os.environ.pop('TT_KEY', '').strip()
if not KEY:
    print('   No TomTom key found on the server.'); sys.exit()
def tile(lat, lon, z):
    n = 2 ** z
    x = int((lon + 180) / 360 * n)
    y = int((1 - math.log(math.tan(math.radians(lat)) + 1 / math.cos(math.radians(lat))) / math.pi) / 2 * n)
    return x, y
ATTR = 'tags(id,icon_category,magnitude_of_delay,delay_in_seconds,description,road_category,start_time,end_time,display_class)'
def get(z, x, y, attrs=False):
    url = f'https://api.tomtom.com/maps/orbis/traffic/incidents/vector/tile/{z}/{x}/{y}?apiVersion=2'
    h = {'TomTom-Api-Key': KEY, 'TomTom-Api-Version': '2', 'Accept': 'application/vnd.mapbox-vector-tile', 'User-Agent': 'TPA-probe'}
    if attrs:
        h['Attributes'] = ATTR
    try:
        with urllib.request.urlopen(urllib.request.Request(url, headers=h), timeout=20) as r:
            return r.status, r.read(), {k.lower(): v for k, v in r.headers.items()}
    except urllib.error.HTTPError as e:
        return e.code, e.read()[:300], {k.lower(): v for k, v in e.headers.items()}
    except Exception as e:
        return 0, str(e).encode()[:200], {}
for z, attrs in ((6, False), (7, False), (8, False), (9, False), (10, False), (12, False), (10, True)):
    x, y = tile(53.80, -1.55, z)
    code, raw, hd = get(z, x, y, attrs)
    print(f'-- zoom {z}{" (with extra details)" if attrs else ""}: answer {code}, {len(raw)} bytes')
    if code != 200:
        print('   ', raw.decode('utf-8', 'replace')[:200]); continue
    try:
        layers = read_tile(raw)
    except Exception as e:
        print('   could not read:', e); continue
    for name, L in layers.items():
        feats = L['features']
        cats = Counter(str(f['props'].get('icon_category_0', f['props'].get('icon_category', '?'))) for f in feats)
        roads = Counter(str(f['props'].get('road_category', '?')) for f in feats)
        print(f'   layer "{name}": {len(feats)} items; kinds {dict(cats.most_common(8))}; roads {dict(roads.most_common(6))}')
        if 'point' in name.lower():
            for f in feats[:3]:
                print('     e.g.', json.dumps({k: v for k, v in f['props'].items() if k != 'id'})[:300])
    for k in ('x-ratelimit-limit', 'x-ratelimit-remaining', 'tracking-id'):
        if k in hd: print(f'   {k}: {hd[k]}')
    time.sleep(0.5)
