class Conn:
    """One keep-alive HTTP/1.1 connection, like one browser tab (a minimal client: standard library only)."""
    def __init__(self, host, port, tls, auth):
        self.host, self.port, self.tls, self.auth = host, port, tls, auth
        self.hosthdr = host if port == (443 if tls else 80) else f'{host}:{port}'
        self.r = self.w = None

    async def close(self):
        if self.w:
            try:
                self.w.close()
            except Exception:
                pass
        self.r = self.w = None

    async def get(self, path, timeout=10.0):
        return await asyncio.wait_for(self._get(path), timeout)

    async def _get(self, path):
        for attempt in (0, 1):
            if self.w is None:
                ctx = ssl.create_default_context() if self.tls else None
                self.r, self.w = await asyncio.open_connection(self.host, self.port, ssl=ctx, server_hostname=self.host if self.tls else None)
            try:
                head = (f'GET {path} HTTP/1.1\r\nHost: {self.hosthdr}\r\nAuthorization: Basic {self.auth}\r\n'
                        'Accept: application/json, image/png\r\nAccept-Encoding: gzip\r\nUser-Agent: tpa-loadtest/' + VERSION +
                        '\r\nConnection: keep-alive\r\n\r\n')
                self.w.write(head.encode()); await self.w.drain()
                status_line = await self.r.readline()
                if not status_line:
                    raise ConnectionError('closed')
                status = int(status_line.split()[1])
                headers = {}
                while True:
                    line = await self.r.readline()
                    if line in (b'\r\n', b'\n', b''):
                        break
                    k, _, v = line.decode('latin-1').partition(':')
                    headers[k.strip().lower()] = v.strip()
                if headers.get('transfer-encoding', '').lower() == 'chunked':
                    body = bytearray()
                    while True:
                        size = int((await self.r.readline()).split(b';')[0], 16)
                        if size == 0:
                            await self.r.readline(); break
                        body += await self.r.readexactly(size); await self.r.readline()
                    body = bytes(body)
                else:
                    body = await self.r.readexactly(int(headers.get('content-length', '0')))
                if headers.get('content-encoding', '').lower() == 'gzip':   # 4.14.0: packed like a real browser gets it
                    body = gzip.decompress(body)
                if headers.get('connection', '').lower() == 'close':
                    await self.close()
                return status, body
            except (ConnectionError, asyncio.IncompleteReadError, OSError):
                await self.close()
                if attempt:
                    raise
        raise ConnectionError('failed')


class Stats:
    def __init__(self):
        self.rows = []          # (time, layer, seconds, ok)
        self.reads = []         # 4.17.0: (viewer, layer, started, finished, complete, pace in seconds)

    def read(self, viewer, layer, t0, t1, ok, poll):
        self.reads.append((viewer, layer, t0, t1, ok, poll))

    def add(self, layer, seconds, ok):
        self.rows.append((time.monotonic(), layer, seconds, ok))

    def since(self, t0):
        return [r for r in self.rows if r[0] >= t0]


def bbox(lat, lon, z, w=1440, h=900, pad=0.2):
    dpp = 360 / (256 * 2 ** z)
    dlon = w * dpp * (1 + 2 * pad) / 2
    dlat = h * dpp * math.cos(math.radians(lat)) * (1 + 2 * pad) / 2
    return f'west={lon - dlon:.4f}&south={lat - dlat:.4f}&east={lon + dlon:.4f}&north={lat + dlat:.4f}'


def view_box(lat, lon, z, w=1440, h=900):
    dpp = 360 / (256 * 2 ** z)
    dlon, dlat = w * dpp / 2, h * dpp * math.cos(math.radians(lat)) / 2
    return lon - dlon, lat - dlat, lon + dlon, lat + dlat


class Pool:
    """4.17.0: a viewer's few keep-alive connections; requests share them, several at once (as a browser does)."""
    def __init__(self, base, n=CONNS_PER_VIEWER):
        self.q = asyncio.Queue()
        self.waiting = 0
        self.all = [Conn(*base) for _ in range(n)]
        for c in self.all:
            self.q.put_nowait(c)

    async def get(self, path, layer, stats, low=False):
        # 4.18.2 (Rob's 4.18.1 run, 18 Nov 01:01: at 1,000 viewers 211 waited too long for planes, 67 for buses, 62 for
        # trains, while every read was quick and the server a third busy): up to 40 new bus route lines per pan queued on
        # the viewer's 2 connections, and the plane, bus and train updates waited behind them. A browser fetches them side
        # by side over one HTTP/2 connection, so an update never waits for route lines. Here route lines (low) step aside
        # whenever an update is waiting for a connection.
        if low:
            while True:
                conn = await self.q.get()
                if not self.waiting:
                    break
                self.q.put_nowait(conn)
                await asyncio.sleep(0.02)
        else:
            self.waiting += 1
            try:
                conn = await self.q.get()
            finally:
                self.waiting -= 1
        try:
            return await fetch(conn, path, layer, stats)
        finally:
            self.q.put_nowait(conn)

    async def close(self):
        for c in self.all:
            await c.close()


async def bus_tiles(pool, lat, lon, z, stats, lines_seen):
    """One bus read as the page does it (hq.js busTileFrame): meta, the tiles covering the screen (all at once), new
    route lines. Returns (complete, seconds until the next read)."""
    slot = int(time.time() // 10)
    ok, body = await pool.get(f'/tiles/bus/meta.json?r={slot}', 'bus', stats)
    if not ok:
        return False, 10.0
    try:
        meta = json.loads(body) if body else None
    except Exception:
        meta = None
    if not isinstance(meta, dict) or not isinstance(meta.get('small'), list) or not isinstance(meta.get('big'), list):
        return None, 10.0                             # no files: the page falls back to the per-viewer answer
    try:
        poll = max(5.0, min(60.0, float(meta.get('every') or 10)))
    except Exception:
        poll = 10.0
    if BUBBLES and z < BUBBLE_BELOW_ZOOM:              # 4.18.0: town bubbles - counts only, no squares
        ok, _ = await pool.get(f'/tiles/bus/counts.json?r={slot}', 'bus', stats)
        return ok, poll
    w, s, e, n = view_box(lat, lon, z)
    if n - s > meta.get('maxSpan', 99):
        return True, poll                             # zoomed too far out: the page shows no buses
    small = n - s <= meta.get('smallBelowSpan', 0)
    size, d = (meta['small'], 's') if small else (meta['big'], 'b')
    r0, r1, c0, c1 = math.floor(s / size[0]), math.floor(n / size[0]), math.floor(w / size[1]), math.floor(e / size[1])
    if (r1 - r0 + 1) * (c1 - c0 + 1) > 80:
        return True, poll
    got = await asyncio.gather(*(pool.get(f'/tiles/bus/{d}/{r}_{c}.json?r={slot}', 'bus', stats)
                                 for r in range(r0, r1 + 1) for c in range(c0, c1 + 1)))
    sids = set()
    for tok, tb in got:
        if small and tb:
            try:
                for it in json.loads(tb):
                    if isinstance(it, dict) and isinstance(it.get('s'), str) and isinstance(it.get('r'), list):
                        sids.add(it['s'])
            except Exception:
                pass
    build = meta.get('build')
    new = sorted(sids - lines_seen)[:40]               # each route line once per viewer (the browser keeps it a week)
    lines_seen.update(new)
    if new:
        # 4.17.1 (Rob's first 4.17.0 run, 16 Nov 11:22: only 46% served at 1,000 with 1 in 20 reads at 0.74 s): the page
        # (hq.js busTileFrame) waits at most 2.5 s for new route lines and then shows the buses anyway, and a browser
        # fetches them all at once over one HTTP/2 connection. So the lines are fetched alongside, as before, but the
        # update counts as shown when its squares are in - not after the last of up to 40 lines over our 2 connections.
        lines = asyncio.ensure_future(asyncio.gather(*(pool.get(f'/tiles/bus/routes/{urllib.parse.quote(str(build))}/'
                                      + urllib.parse.quote(''.join(ch if ch.isalnum() or ch in '_.-' else '_' for ch in sid)[:120]) + '.json',
                                      'bus', stats, low=True) for sid in new)))
        BACKGROUND.add(lines)
        lines.add_done_callback(BACKGROUND.discard)
    return all(tok for tok, _ in got), poll


def page_box(lat, lon, z, w=1440, h=900):
    """4.16.0: the area the page asks about for trains (hq.js viewBox): the screen padded by a fifth, snapped to a grid."""
    w0, s0, e0, n0 = view_box(lat, lon, z, w, h)
    pw, ph = (e0 - w0) * 0.2, (n0 - s0) * 0.2
    w0, s0, e0, n0 = w0 - pw, s0 - ph, e0 + pw, n0 + ph
    g = min(4.0, max(1 / 1024, 2.0 ** math.floor(math.log2(max(n0 - s0, 1e-4) / 4))))
    gl = g * 2
    return math.floor(w0 / gl) * gl, math.floor(s0 / g) * g, math.ceil(e0 / gl) * gl, math.ceil(n0 / g) * g


