def tiles_for(lat, lon, z):
    n = 2 ** z
    x = int((lon + 180) / 360 * n)
    y = int((1 - math.asinh(math.tan(math.radians(lat))) / math.pi) / 2 * n)
    return [(z, x + dx, y + dy) for dx in (0, 1) for dy in (0, 1)]


async def viewer(i, base, stats, stop, rnd, layers):
    """One pretend person with the page open. 4.17.0: each layer is read on its own timer, side by side (as the page
    does), and every completed update is recorded (stats.updates) so the step can tell who got the TPA standard."""
    city = rnd.choice(CITIES)
    view = {'lat': city[1] + rnd.uniform(-0.03, 0.03), 'lon': city[2] + rnd.uniform(-0.05, 0.05),
            'z': rnd.choice([10, 11, 12, 13, 14, 15, 16])}   # 4.14.0: some look zoomed out, where answers are biggest
    pool = Pool(base)
    moved = {l: asyncio.Event() for l in layers}
    lines_seen = set()

    async def layer_loop(layer):
        await asyncio.sleep(rnd.uniform(0, 3))                     # a page opens: asks straight away
        while not stop.is_set():
            t0 = time.monotonic()
            lat, lon, z = view['lat'], view['lon'], view['z']
            ok = None
            if layer == 'bus' and not BUS_API:                     # 4.15.0: as the page reads buses now
                ok, poll = await bus_tiles(pool, lat, lon, z, stats, lines_seen)
            elif layer == 'rail' and not RAIL_API:                 # 4.16.0: as the page reads trains now
                ok, poll = await rail_tiles(pool, lat, lon, z, stats)
            if ok is None:                                         # no files (or the old way asked for): per-viewer answer
                ok, body = await pool.get(f'/api/v4/components/{layer}/snapshot?{bbox(lat, lon, z)}', layer, stats)
                poll = 15.0
                if body:
                    try:
                        poll = max(5.0, min(60.0, json.loads(body).get('nextPollAfterMs', 15000) / 1000))
                    except Exception:
                        pass
            stats.read(i, layer, t0, time.monotonic(), ok, poll)
            moved[layer].clear()
            try:                                                   # the next read: after its pace, or at once after a pan
                await asyncio.wait_for(moved[layer].wait(), poll)
                await asyncio.sleep(0.3)
            except asyncio.TimeoutError:
                pass

    async def panner():
        while not stop.is_set():
            await asyncio.sleep(rnd.uniform(20, 40))               # pans or zooms, then asks again for the new area
            z = view['z']
            view['lat'] += rnd.uniform(-1, 1) * 900 * 360 / (256 * 2 ** z) * 0.4
            view['lon'] += rnd.uniform(-1, 1) * 1440 * 360 / (256 * 2 ** z) * 0.4
            view['z'] = max(10, min(17, z + rnd.choice([-1, 0, 0, 1])))
            for ev in moved.values():
                ev.set()
            if TRAFFIC and 'road' in layers_all(layers):           # 4.13.2: only with --traffic (TomTom's monthly allowance)
                await asyncio.gather(*(pool.get(f'/api/v4/components/road/tiles/{tz}/{tx}/{ty}.png', 'traffic', stats)
                                       for tz, tx, ty in tiles_for(view['lat'], view['lon'], min(view['z'], 15))))

    try:
        if TRAFFIC and 'road' in layers_all(layers):               # a page opening shows the traffic straight away
            await asyncio.gather(*(pool.get(f'/api/v4/components/road/tiles/{tz}/{tx}/{ty}.png', 'traffic', stats)
                                   for tz, tx, ty in tiles_for(view['lat'], view['lon'], min(view['z'], 15))))
        jobs = [asyncio.create_task(layer_loop(l)) for l in layers] + [asyncio.create_task(panner())]
        try:
            await stop.wait()
        finally:
            for j in jobs:
                j.cancel()
            got = await asyncio.gather(*jobs, return_exceptions=True)
            for r in got:
                if isinstance(r, PermissionError):
                    raise r
    finally:
        await pool.close()


def layers_all(layers):
    return set(layers) | {'road'}


async def fetch(conn, path, layer, stats):
    """(answered properly, body or None). A 404 is a proper answer (a square with nothing in it); a failure is not."""
    t0 = time.monotonic()
    try:
        status, body = await conn.get(path)
        ok = status < 500 and status not in (401, 403)
        stats.add(layer, time.monotonic() - t0, ok)
        if status == 401:
            raise PermissionError('password not accepted')
        return ok, (body if status == 200 else None)
    except PermissionError:
        raise
    except asyncio.CancelledError:
        await conn.close()
        raise
    except Exception:
        stats.add(layer, time.monotonic() - t0, False)
        await conn.close()
        return False, None


def server_stats(enabled):
    if not enabled:
        return None
    cmd = 'systemctl show -p Id -p CPUUsageNSec -p MemoryCurrent -p MemoryMax ' + ' '.join(UNITS) + '; echo; cat /proc/loadavg; nproc'
    try:
        out = subprocess.run(['ssh', '-i', KEY, '-o', 'BatchMode=yes', '-o', 'ConnectTimeout=8', SERVER, cmd],
                             capture_output=True, text=True, timeout=25).stdout
    except Exception:
        return None
    units, cur = {}, {}
    for line in out.splitlines():
        if '=' in line:
            k, _, v = line.partition('=')
            cur[k] = v
            if k == 'Id':
                units[v.replace('.service', '')] = cur
        elif not line.strip():
            cur = {}
    lines = [l for l in out.splitlines() if l.strip()]
    load = lines[-2].split()[0] if len(lines) >= 2 else '?'
    cpus = lines[-1].strip() if lines else '?'
    snap = {'at': time.monotonic(), 'load': load, 'cpus': cpus, 'units': {}}
    for name, d in units.items():
        num = lambda k: int(d[k]) if d.get(k, '').isdigit() else None
        snap['units'][name] = {'cpu': num('CPUUsageNSec'), 'mem': num('MemoryCurrent'), 'max': num('MemoryMax')}
    return snap


def pct(values, p):
    if not values:
        return None
    s = sorted(values)
    return s[min(len(s) - 1, int(round(p / 100 * (len(s) - 1))))]


def served_detail(reads, n, t_from, t_to, grace):
    """4.18.1 (Rob's 4.18.0 run, 18 Nov 00:50: 1,000 viewers only 76% served, yet reads were fast and the server 35% busy):
    which layer kept viewers from being served, and how long its longest gap was, so the figure says why."""
    done, layers = {}, set()
    for v, layer, t0, t1, ok, poll in reads:
        layers.add(layer)
        if ok:
            done.setdefault((v, layer), []).append((t1, poll))
    out = {}
    for layer in sorted(layers):
        missed, worst, over = 0, 0.0, []
        for v in range(n):
            times = sorted(done.get((v, layer), []))
            if not times:
                missed += 1
                continue
            pace = max(pc for _, pc in times) + grace
            marks = [t_from] + [t for t, _ in times if t_from <= t <= t_to] + [t_to]
            gaps = [b - a for a, b in zip(marks, marks[1:])]
            if any(g > pace for g in gaps):
                missed += 1
                over.append(max(gaps) - pace + grace)
            worst = max(worst, max(gaps))
        took = sorted(t1 - t0 for vv, ll, t0, t1, ok, pc in reads if ll == layer and ok and t_from <= t1 <= t_to)
        out[layer] = {'missed': missed, 'worst': worst, 'late': pct(over, 50) if over else None,
                      'p99': pct(took, 99) if took else None, 'slowest': took[-1] if took else None}
    return out


def served_share(reads, n, t_from, t_to, grace):
    """4.17.0, rule 1: the share of the n viewers who got a fresh update of every layer at least every (pace + grace)
    seconds from t_from to t_to - counting the wait from t_from to their first update in the window and from their
    last update to t_to. A read that did not complete is no update."""
    done, layers = {}, set()
    for v, layer, t0, t1, ok, poll in reads:
        layers.add(layer)
        if ok:
            done.setdefault((v, layer), []).append((t1, poll))
    if not n or not layers:
        return 0.0
    good = 0
    for v in range(n):
        fine = True
        for layer in layers:
            times = sorted(done.get((v, layer), []))
            if not times:
                fine = False
                break
            pace = max(pc for _, pc in times) + grace
            marks = [t_from] + [t for t, _ in times if t_from <= t <= t_to] + [t_to]
            if any(b - a > pace for a, b in zip(marks, marks[1:])):
                fine = False
                break
        good += fine
    return good / n


async def run_step(n, seconds, base, layers, rnd):
    stats, stop = Stats(), asyncio.Event()
    tasks = []
    started = time.monotonic()
    aborted = ''
    ramp = min(15.0, seconds / 4)
    lags = []

    async def watchdog():
        nonlocal aborted
        while not stop.is_set():
            try:
                await asyncio.wait_for(stop.wait(), 10)
                return
            except asyncio.TimeoutError:
                pass
            recent = stats.since(time.monotonic() - 10)
            if len(recent) >= 20 and sum(1 for r in recent if not r[3]) / len(recent) > 0.20:
                aborted = 'more than 20% of requests failing'
                stop.set()

    async def tester_lag():                         # 4.17.0: is Cloud Shell itself keeping up?
        while not stop.is_set():
            t = time.monotonic()
            await asyncio.sleep(0.2)
            lags.append((time.monotonic(), time.monotonic() - t - 0.2))

    async def spawn():
        for i in range(n):
            if stop.is_set():
                return
            tasks.append(asyncio.create_task(viewer(i, base, stats, stop, random.Random(rnd.random()), layers)))
            await asyncio.sleep(ramp / n)

    wd = asyncio.create_task(watchdog())
    lt = asyncio.create_task(tester_lag())
    await spawn()
    spawned = time.monotonic()        # 4.18.3: when the last viewer actually opened its page
    try:
        await asyncio.wait_for(stop.wait(), max(0.0, seconds - (time.monotonic() - started)))
    except asyncio.TimeoutError:
        pass
    ended = time.monotonic()
    stop.set()
    results = await asyncio.gather(*tasks, return_exceptions=True)
    wd.cancel(); lt.cancel()
    if any(isinstance(r, PermissionError) for r in results):
        raise PermissionError('password not accepted')
    elapsed = ended - started
    # 4.18.3 (Rob's 4.18.2 run, 18 Nov 01:12: at 1,000, 198/68/55 viewers "waited" up to 15 s for planes/buses/trains while
    # no read took over 1.2 s): the clock started at ramp + 3 s, but opening 1,000 pages one every 15 ms takes longer than
    # the planned 15 s on Cloud Shell, so the last viewers to open were counted as waiting before their page even existed.
    # The clock now starts 3 s after the LAST viewer really opened its page.
    settled = max(started + ramp, spawned) + 3                     # every viewer has asked for its first update by now
    rows = [r for r in stats.rows if r[0] >= started + ramp]       # the settled part of the step
    if not rows:
        rows = stats.rows
    fails = sum(1 for r in rows if not r[3])
    reads = [r for r in stats.reads if r[3] >= started + ramp]
    durations = [r[3] - r[2] for r in reads if r[4]] + [99.0 for r in reads if not r[4]]
    by_layer = {}
    for r in reads:
        by_layer.setdefault(r[1], []).append(r[3] - r[2] if r[4] else 99.0)
    lag = [x for t, x in lags if t >= started + ramp]
    return {'n': n, 'elapsed': elapsed, 'requests': len(rows), 'rate': len(rows) / max(1e-9, elapsed - ramp if elapsed > ramp else elapsed),
            'served': served_share(stats.reads, n, settled, ended, LIMITS['grace']) if not aborted and ended > settled else 0.0,
            'p50': pct(durations, 50), 'p95': pct(durations, 95), 'fail': fails / len(rows) if rows else 1.0,
            'layers': {k: (pct(v, 50), pct(v, 95), len(v)) for k, v in by_layer.items()}, 'aborted': aborted,
            'lag95': pct(lag, 95), 'lagmax': max(lag) if lag else None, 'spawn': spawned - started,
            'why': served_detail(stats.reads, n, settled, ended, LIMITS['grace']) if not aborted and ended > settled else {}}


def server_use(before, after):
    if not before or not after:
        return None
    wall = max(1e-9, after['at'] - before['at'])
    out = {'load': after['load'], 'cpus': after['cpus'], 'units': {}}
    for name, a in after['units'].items():
        b = before['units'].get(name, {})
        cpu = (a['cpu'] - b['cpu']) / 1e9 / wall if a.get('cpu') is not None and b.get('cpu') is not None else None
        memf = a['mem'] / a['max'] if a.get('mem') and a.get('max') and a['max'] < 2 ** 62 else None
        out['units'][name] = {'cpu': cpu, 'mem': a.get('mem'), 'memf': memf}
    return out


def fmt_s(v):
    return '   -  ' if v is None else f'{v:5.2f}s'


def tester_behind(step):
    """4.17.0: Cloud Shell (the pretend crowd) fell behind its own timers - the step measured the tester, not the server."""
    return step.get('lag95') is not None and step['lag95'] > LIMITS['lag']


def verdict(step, use):
    why = []
    if step['aborted']:
        why.append(step['aborted'])
    if step['served'] < LIMITS['served']:
        why.append(f"only {step['served']:.0%} of viewers got a fresh update every {10 + LIMITS['grace']:.0f} s (needs {LIMITS['served']:.0%})")
    if step['p95'] is None or step['p95'] > LIMITS['p95']:
        why.append(f"1 in 20 reads took over {fmt_s(step['p95']).strip()} (limit {LIMITS['p95']:.0f} s)")
    if step['fail'] >= LIMITS['fail']:
        why.append(f"{step['fail']:.1%} of requests failed (limit: under {LIMITS['fail']:.0%})")
    if use:
        for name, u in use['units'].items():
            if u['memf'] is not None and u['memf'] > LIMITS['mem']:
                why.append(f"{name} at {u['memf']:.0%} of its memory limit")
    return why


def total_cpu(use):
    return sum(u['cpu'] or 0 for u in use['units'].values()) if use else 0.0


def proven(healthy, tester_stop=False):
    """4.17.0 (Rob 16 Nov 2026 10:34: "it needs to actually mean that ... summarise what that would mean for daily
    traffic"): what this run proved, in people, and what that means a day (rule of thumb: busiest moment x 36)."""
    if not healthy:
        return ['PROVEN: nothing - not even the first step met the TPA standard.']
    n = healthy[-1]['n']
    out = [f"PROVEN: {n:,} viewers at once all got the TPA standard (fresh updates at least every {10 + LIMITS['grace']:.0f} s, "
           f"19 in 20 reads within {LIMITS['p95']:.0f} s, under 1 in 100 requests failed).",
           f"In visitors a day: roughly {36 * n:,} (rule of thumb: busiest moment x 36; anywhere from about {18 * n:,} to "
           f"{72 * n:,}, depending on how bunched up visitors are)."]
    if tester_stop:
        out.append('The server may cope with more: Cloud Shell could not pretend to be more people than this.')
    out.append('Anything below is a guess from processor use, not proven.')
    return out


def estimate(healthy, uses, base=None):
    """From the biggest healthy step: what one viewer costs, and what bigger crowds would need.
    4.13.1 (1 Nov 21:20): the server's own background work with nobody watching (``base``, measured before the
    first step) is taken off first - before, it was counted as if viewers caused it, making per-viewer cost too high."""
    lines = []
    if not healthy:
        return ['No step was healthy, so there is nothing to estimate from: the server struggles even at the first step.']
    best = healthy[-1]
    use = uses.get(best['n'])
    lines.append(f"Biggest healthy step: {best['n']} viewers, {best['rate']:.1f} requests a second, typical answer {fmt_s(best['p50']).strip()}.")
    if use:
        cpu = total_cpu(use)
        idle = total_cpu(base) if base else 0.0
        try:
            cores = float(use['cpus'])
        except ValueError:
            cores = 1.0
        per = max(0.0, cpu - idle) / best['n']
        if base:
            lines.append(f"With nobody watching the server already uses {idle:.2f} cores (following every bus, train and plane).")
        lines.append(f"Server processor in use: {cpu:.2f} of {cores:.0f} cores ({cpu / cores:.0%}); about {per * 1000:.1f} thousandths of a core per viewer.")
        if per > 0:
            cap = int(max(0.0, cores * 0.8 - idle) / per)
            lines.append(f"Estimate: this server tops out around {cap} viewers (80% of its processor) - the real limit may be lower.")
            for big in (1000, 10000, 100000, 1000000):
                if big > cap:
                    lines.append(f"  {big:>9,} viewers at once would need about {(big * per + idle) / 0.8:,.0f} cores of the same speed, if nothing changed.")
        busiest = max(use['units'].items(), key=lambda kv: kv[1]['cpu'] or 0)
        lines.append(f"Busiest part: {busiest[0]} ({(busiest[1]['cpu'] or 0):.2f} cores).")
    lines.append('Big crowds are reached by sharing work, not more cores: ready-made answers per map area ("chunks"),')
    lines.append('refreshed every few seconds and cached by Cloudflare, so cost follows areas watched, not people watching.')
    return lines


async def main_async(args, base, layers):
    rnd = random.Random(args.seed)
    healthy, uses = [], {}
    idle_use = None
    tester_stop = False
    if args.server_stats:            # 4.13.1: the server's own work with nobody watching, first
        print('Measuring the server with nobody watching (30 s)...', flush=True)
        b0 = server_stats(True); await asyncio.sleep(30); idle_use = server_use(b0, server_stats(True))
    print(BANNER_FROM)                   # 4.14.1 (owner 13 Nov 13:09: "could do with the cut from and to part back")
    print(f"TPA load test {VERSION} · {args.host or args.url} · steps {', '.join(map(str, args.steps))} · {args.seconds:.0f} s each"
          f" · buses {'the old way (--bus-api)' if BUS_API else 'as the page reads them (bus files)'}"
          f" · trains {'the old way (--rail-api)' if RAIL_API else 'as the page reads them (train files)'}")
    print(f"TPA standard: every viewer gets a fresh update at least every {10 + LIMITS['grace']:.0f} s, 19 in 20 reads within "
          f"{LIMITS['p95']:.0f} s, under 1 in 100 requests fail. 'served' = viewers who got that for the whole step.")
    print("bus / rail / air = how long 1 in 20 of that layer's reads took (the slowest layer is the one holding viewers back).")
    print(f"{'viewers':>8} {'served':>7} {'req/s':>7} {'typical':>8} {'1 in 20':>8} {'failed':>7}  {'bus':>6} {'rail':>6} {'air':>6} {'traffic':>7} {'tester':>7}  server")
    for n in args.steps:
        before = server_stats(args.server_stats)
        step = await run_step(n, args.seconds, base, layers, rnd)
        after = server_stats(args.server_stats)
        use = server_use(before, after)
        uses[n] = use
        lay = step['layers']
        srv = ''
        if use and not use['units']:      # 4.13.3 (owner 3 Nov 20:26: crashed here at 250 viewers): figures not readable
            srv = 'server figures not readable this step'
        elif use:
            cpu = sum(u['cpu'] or 0 for u in use['units'].values())
            top = max(use['units'].items(), key=lambda kv: kv[1]['memf'] or 0)
            srv = f"cpu {cpu:.2f}/{use['cpus']} · load {use['load']} · fullest {top[0]} {(top[1]['memf'] or 0):.0%}"
        print(f"{n:>8} {step['served']:>7.0%} {step['rate']:>7.1f} {fmt_s(step['p50']):>8} {fmt_s(step['p95']):>8} {step['fail']:>7.1%}  "
              f"{fmt_s(lay.get('bus', (None, None))[1]):>6} {fmt_s(lay.get('rail', (None, None))[1]):>6} {fmt_s(lay.get('air', (None, None))[1]):>6} "
              f"{fmt_s(lay.get('traffic', (None, None))[1]):>7} {fmt_s(step['lag95']):>7}  {srv}", flush=True)
        why = [(k, v) for k, v in step.get('why', {}).items() if v['missed']]
        if why and step['served'] < 0.99:  # 4.18.1: which layer kept viewers waiting, and the tester's own worst stall
            print('         not served because of: ' + '; '.join(
                f"{k} {v['missed']} viewers (longest wait {v['worst']:.1f} s, typically {v['late']:.1f} s over its pace + 2 s;"
                f" 1 in 100 reads took {fmt_s(v['p99'])}, slowest {fmt_s(v['slowest'])})"
                if v['late'] is not None else f"{k} {v['missed']} viewers (no update at all)" for k, v in why)
                + (f" · tester's worst stall {step['lagmax']:.1f} s" if step.get('lagmax') is not None else '')
                + (f" · all {n} pages open after {step['spawn']:.0f} s" if step.get('spawn') else ''), flush=True)
        if tester_behind(step):          # 4.17.0: the pretend crowd, not the server, could not keep up
            tester_stop = True
            print(f"STOPPED at {n} viewers: Cloud Shell (the tester) fell {step['lag95']:.1f} s behind its own timers, so this "
                  f"step measured the tester, not the server. It is not counted either way.")
            break
        why = verdict(step, use)
        if why:
            print(f"STOPPED at {n} viewers: " + '; '.join(why))
            break
        healthy.append(step)
        if n != args.steps[-1]:
            await asyncio.sleep(args.pause)       # let the server settle between steps
    else:
        print(f"All steps healthy up to {args.steps[-1]} viewers.")
    print()
    for line in proven(healthy, tester_stop):
        print(line)
    for line in estimate(healthy, uses, idle_use):
        print(line)
    print(BANNER_TO)
    return 0 if healthy else 1


def main():
    p = argparse.ArgumentParser(description='How many people can the TPA test site serve at once? (read-only)')
    p.add_argument('--host', default='test.tpalive.co.uk')
    p.add_argument('--url', default=None, help=argparse.SUPPRESS)
    p.add_argument('--steps', default=','.join(map(str, DEFAULT_STEPS)))
    p.add_argument('--seconds', type=float, default=90)
    p.add_argument('--pause', type=float, default=20, help=argparse.SUPPRESS)
    p.add_argument('--seed', type=int, default=None, help=argparse.SUPPRESS)
    p.add_argument('--no-server-stats', dest='server_stats', action='store_false')
    p.add_argument('--yes', action='store_true')
    p.add_argument('--traffic', action='store_true',
                   help='also fetch traffic pictures (uses the TomTom monthly allowance: 12,000 pictures)')
    p.add_argument('--bus-api', action='store_true',
                   help='buses the old way (each viewer asks the server), as before HQ 4.56 - for comparison only')
    p.add_argument('--rail-api', action='store_true',
                   help='trains the old way (each viewer asks the server), as before HQ 4.65 - for comparison only')
    p.add_argument('--no-bubbles', dest='bubbles', action='store_false',
                   help='squares at every zoom, as before the town bubbles (HQ 4.67) - for comparison only')
    args = p.parse_args()
    global TRAFFIC, SERVER, BUS_API, RAIL_API, BUBBLES
    BUBBLES = args.bubbles
    TRAFFIC = args.traffic
    BUS_API = args.bus_api
    RAIL_API = args.rail_api
    if args.server_stats and not args.url:
        SERVER = server_for(args.host) or SERVER
        print(f'Server figures from: {SERVER.split("@")[1]} (where {args.host} points)')
    args.steps = [int(x) for x in args.steps.split(',') if x.strip()]
    if args.url:
        u = urllib.parse.urlsplit(args.url)
        host, port, tls = u.hostname, u.port or (443 if u.scheme == 'https' else 80), u.scheme == 'https'
        args.host = None
    else:
        host, port, tls = args.host, 443, True
    pw = os.environ.get('TPA_LOADTEST_PASSWORD')
    if pw is None:
        pw = getpass.getpass('Test-site password (user "tpa"; hidden as you type): ')
    auth = base64.b64encode(f'tpa:{pw}'.encode()).decode()
    if not args.yes:
        print('This makes the test site slow for a few minutes while it runs. Nothing is changed.')
        if input('Type yes to start: ').strip().lower() != 'yes':
            print('Not started.'); return 2
    try:
        return asyncio.run(main_async(args, (host, port, tls, auth), LAYERS))
    except PermissionError:
        print('The test site did not accept that password - nothing was tested.'); return 3
    except KeyboardInterrupt:
        print('\nStopped by you.'); return 130


if __name__ == '__main__':
    sys.exit(main())
