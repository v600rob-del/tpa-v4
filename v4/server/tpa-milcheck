#!/usr/bin/env python3
"""tpa-milcheck - LOOK-ONLY: one request to FlyItalyADSB's worldwide military list, to see what it returns.

Rob 24 Nov 2026 16:37-16:42: the world view after the planes Easter egg should show military activity worldwide. FlyItalyADSB
documents GET /v2/mil ("military aircraft seen now") on the free plan we already use. Before building, this measures: does
it answer for our key, how many aircraft, how big, how long, which fields they carry, where in the world they are, and the
allowance headers. It makes ONE request (counted in our FlyItalyADSB month like any other), changes nothing, and never
prints the key.

  sudo python3 -B -u tpa-milcheck [env file]
"""
import json
import os
import sys
import time
from collections import Counter
from urllib.error import HTTPError, URLError
from urllib.parse import urlsplit
from urllib.request import Request, urlopen

ENV_FILE = '/etc/tpa/air.env'
URLS = [u for u in (os.environ.get('TPA_MILCHECK_URL', '').strip(),) if u] or [
    'https://api.flyitalyadsb.com/v2/mil',                       # the documented address
    'https://api.flyitalyadsb.com/api/aircraft/v2/mil/']         # the address style the air engine uses for circles
REGIONS = [('UK and Ireland', 49, 61, -11, 2.5), ('Rest of Europe', 34, 72, -25, 45), ('Middle East', 12, 42, 25, 63),
           ('USA and Canada', 15, 72, -170, -50), ('Asia and Pacific', -50, 72, 63, 180)]


def say(text):
    print(text, flush=True)


def key_from(path):
    try:
        with open(path, encoding='utf-8') as f:
            for line in f:
                if line.startswith('TPA_FLYITALY_API_KEY='):
                    return line.split('=', 1)[1].strip().strip('"\'')
    except OSError:
        return None
    return None


def region(lat, lon):
    for name, s, n, w, e in REGIONS:
        if s <= lat <= n and w <= lon <= e:
            return name
    return 'Elsewhere'


def fetch(url, key):
    req = Request(url, headers={'X-Api-Key': key, 'api-auth': key, 'Accept': 'application/json',
                                'User-Agent': 'TPA-milcheck (+mailto:tpaprojectuk@gmail.com)'})
    t0 = time.time()
    try:
        with urlopen(req, timeout=30) as res:
            raw = res.read(30_000_000)
            hdr = {k.lower(): v for k, v in res.headers.items() if k.lower().startswith('x-ratelimit')}
            return res.status, raw, time.time() - t0, hdr
    except HTTPError as exc:
        hdr = {k.lower(): v for k, v in (exc.headers or {}).items() if k.lower().startswith('x-ratelimit')}
        return exc.code, b'', time.time() - t0, hdr
    except (URLError, TimeoutError, OSError) as exc:
        return f'network-{type(exc).__name__}', b'', time.time() - t0, {}


def report(raw):
    data = json.loads(raw)
    ac = data.get('ac') or data.get('aircraft') or []
    say(f'aircraft: {len(ac)}')
    placed = [a for a in ac if isinstance(a, dict) and isinstance(a.get('lat'), (int, float)) and isinstance(a.get('lon'), (int, float))]
    say(f'with a position: {len(placed)}')
    fields = Counter(k for a in ac if isinstance(a, dict) for k in a)
    say('fields (how many aircraft carry each): ' + ', '.join(f'{k} {n}' for k, n in fields.most_common(30)))
    where = Counter(region(a['lat'], a['lon']) for a in placed)
    say('where: ' + ', '.join(f'{k} {n}' for k, n in where.most_common()))
    ages = sorted(a.get('seen_pos') for a in placed if isinstance(a.get('seen_pos'), (int, float)))
    if ages:
        say(f'report age (s): median {ages[len(ages) // 2]:.0f}, 9 in 10 under {ages[int(len(ages) * 0.9)]:.0f}')
    types = Counter((a.get('t') or '?') for a in ac if isinstance(a, dict))
    say('commonest types: ' + ', '.join(f'{k} {n}' for k, n in types.most_common(12)))
    say('examples:')
    for a in placed[:8]:
        say(f"  {a.get('hex', '?')} {str(a.get('flight') or '').strip() or '-'} {a.get('t') or '?'} {a.get('r') or '-'} "
            f"{a['lat']:.1f},{a['lon']:.1f} {a.get('alt_baro', '?')} ft")


def main(argv):
    say('tpa-milcheck: look-only, one request to FlyItalyADSB, changes nothing. About 5 seconds.')
    key = key_from(argv[1] if len(argv) > 1 else ENV_FILE)
    say('=== COPY BACK START ===')
    say(time.strftime('%d %b %H:%M'))
    if not key:
        say('No FlyItalyADSB key found in the env file (nothing was asked).')
        say('=== COPY BACK END ===')
        return 2
    for url in URLS:
        status, raw, secs, hdr = fetch(url, key)
        say(f"{urlsplit(url).path}: answer {status}, {len(raw) // 1024} KB in {secs:.1f} s"
            + (' | ' + ', '.join(f'{k}={v}' for k, v in sorted(hdr.items())) if hdr else ''))
        if status == 200 and raw:
            try:
                report(raw)
            except (ValueError, TypeError, AttributeError) as exc:
                say(f'answer not readable: {type(exc).__name__}')
            break
    say('=== COPY BACK END ===')
    return 0


if __name__ == '__main__':
    sys.exit(main(sys.argv))
