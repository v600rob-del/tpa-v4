# TPA web front door (/etc/tpa-web/Caddyfile). Values come from /etc/tpa/web.env, written by "sudo tpa-setup":
#   TPA_HOST       the site name, e.g. test.tpalive.co.uk (gets a free HTTPS certificate)
#   TPA_SITE_HASH  scrambled (bcrypt) form of the private test password
# HQ itself only listens on 127.0.0.1:8778; this is the only way in from the internet.
{
	admin off
	# HTTP/1.1 and HTTP/2 only. HTTP/3 needs UDP 443, which Oracle's firewall does not
	# let in; offering it made Chrome hang on a blank page (30 Oct 2026).
	servers {
		protocols h1 h2
	}
}

{$TPA_HOST} {
	basic_auth {
		tpa {$TPA_SITE_HASH}
	}
	encode gzip
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Robots-Tag "noindex, nofollow"
		-Server
	}
	# kit 4.57 (Plan B, owner 13 Nov 2026 19:15): ready-made bus tiles, written by the bus engine every 10 s into
	# /run/tpa-bus-tiles (in memory), handed out by Caddy itself - packed once (.gz), never by Python per visitor.
	# kit 4.66 (rail 1.6.0, Rob 16 Nov 2026 07:25 "let's proceed"): ready-made train files, written by the train engine every
	# 10 s into /run/tpa-rail-tiles/rail (in memory), handed out the same way. Caddy tries the longer path first.
	# kit 4.68: the privacy page and share picture on the test site too (same files as the public site)
	@public path /robots.txt /sitemap.xml /privacy /privacy.html /help /help.html /share.jpg /404.html
	handle @public {
		root * /opt/tpa/public
		rewrite /privacy /privacy.html
		rewrite /help /help.html
		file_server
	}
	handle_path /tiles/rail/* {
		root * /run/tpa-rail-tiles/rail
		header Cache-Control "public, max-age=10"
		file_server {
			precompressed gzip
		}
	}
	handle_path /tiles/* {
		root * /run/tpa-bus-tiles
		@lines path /bus/routes/*
		@live not path /bus/routes/*
		header @live Cache-Control "public, max-age=10"
		header @lines Cache-Control "public, max-age=604800, immutable"
		file_server {
			precompressed gzip
		}
	}
	handle {
		reverse_proxy 127.0.0.1:8778
	}
}

# kit 4.68 - LAUNCH (Rob 18 Nov 2026 01:24: "forget the coming soon, we go live tonight"): the main address is the live
# map, open to everyone (no password). The test site above keeps its password, its "noindex" and the owner pages.
# Way back to "coming soon": install the kit before this one (kit 4.67). Earlier (kit 4.16) this served /opt/tpa/soon.
tpalive.co.uk {
	encode gzip
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}
	# owner-only pages are not for visitors (the owner uses the test site); Kids mode is parked
	# (kit 4.68.1: inside a handle - a bare "respond" runs after the catch-all handle below, so it never answered)
	@owner path /full /full/* /admin /admin/* /kids /kids/* /suggestions /suggestions/*
	handle @owner {
		error 404
	}
	# test addresses on the page itself go back to the normal map
	@testq {
		path / /index.html /user
		expression `{query.motion} != "" || {query.forecast} != "" || {query.show} != "" || {query.bubbles} != "" || {query.tiles} != "" || {query.railtiles} != "" || {query.view} != ""`
	}
	redir @testq / 302
	# privacy page, share picture, robots file and sitemap (search engines)
	@public path /robots.txt /sitemap.xml /privacy /privacy.html /help /help.html /share.jpg /404.html
	handle @public {
		root * /opt/tpa/public
		rewrite /privacy /privacy.html
		rewrite /help /help.html
		file_server
	}
	handle_path /tiles/rail/* {
		root * /run/tpa-rail-tiles/rail
		header Cache-Control "public, max-age=10"
		file_server {
			precompressed gzip
		}
	}
	handle_path /tiles/* {
		root * /run/tpa-bus-tiles
		@lines path /bus/routes/*
		@live not path /bus/routes/*
		header @live Cache-Control "public, max-age=10"
		header @lines Cache-Control "public, max-age=604800, immutable"
		file_server {
			precompressed gzip
		}
	}
	# kit 4.69 (tidy-up after launch): a friendly "page not found" for addresses people type (not for the map's own data)
	@pages not path /api/* /assets/* /tiles/* /basemap/* /data/* /hq-* /styles/* /fonts/* /sprites/* /natural_earth/*
	handle @pages {
		reverse_proxy 127.0.0.1:8778 {
			@missing status 404
			handle_response @missing {
				root * /opt/tpa/public
				rewrite * /404.html
				file_server {
					status 404
				}
			}
		}
	}
	handle {
		reverse_proxy 127.0.0.1:8778
	}
	handle_errors 404 {
		root * /opt/tpa/public
		rewrite * /404.html
		file_server {
			status 404
		}
	}
}

www.tpalive.co.uk {
	redir https://tpalive.co.uk{uri} permanent
}

# kit 4.56 (owner 13 Nov 16:36: "yes its ok to do the cloudflare proof"): a password-free test address holding ONLY
# dummy files that tpa-cftest writes and removes (/var/lib/tpa-cftest; empty = every address answers "not found").
# Proves Cloudflare shares live tiles before Stage 1 is built. Needs the DNS record cftest (orange cloud) in
# Cloudflare; remove that record to switch it off. "tls internal": Cloudflare (SSL mode Full) talks to us with our own
# certificate, so nothing waits on a public certificate; plain http too, for SSL mode Flexible.
cftest.tpalive.co.uk, http://cftest.tpalive.co.uk {
	tls internal
	header {
		X-Robots-Tag "noindex, nofollow"
		-Server
	}
	header /r/* Cache-Control "public, max-age=86400, immutable"
	header /short/* Cache-Control "public, max-age=10"
	header /latest.json Cache-Control "public, max-age=2"
	root * /var/lib/tpa-cftest
	file_server
}
