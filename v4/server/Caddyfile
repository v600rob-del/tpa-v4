# TPA web front door (/etc/tpa-web/Caddyfile). Values come from /etc/tpa/web.env, written by "sudo tpa-setup":
#   TPA_HOST       the site name, e.g. test.tpalive.co.uk (gets a free HTTPS certificate)
#   TPA_SITE_HASH  scrambled (bcrypt) form of the private test password
# HQ itself only listens on 127.0.0.1:8778; this is the only way in from the internet.
{
	admin off
	# HTTP/1.1 and HTTP/2 only. HTTP/3 needs UDP 443, which Oracle's firewall does not
	# let in; offering it made Chrome hang on a blank page (30 Oct 2026).
	servers {
		protocols h1 h2
	}
}

{$TPA_HOST} {
	basic_auth {
		tpa {$TPA_SITE_HASH}
	}
	encode gzip
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Robots-Tag "noindex, nofollow"
		-Server
	}
	# kit 4.57 (Plan B, owner 13 Nov 2026 19:15): ready-made bus tiles, written by the bus engine every 10 s into
	# /run/tpa-bus-tiles (in memory), handed out by Caddy itself - packed once (.gz), never by Python per visitor.
	handle_path /tiles/* {
		root * /run/tpa-bus-tiles
		@lines path /bus/routes/*
		@live not path /bus/routes/*
		header @live Cache-Control "public, max-age=10"
		header @lines Cache-Control "public, max-age=604800, immutable"
		file_server {
			precompressed gzip
		}
	}
	handle {
		reverse_proxy 127.0.0.1:8778
	}
}

# kit 4.16 (owner 5 Nov 15:50: "have the main site display a coming soon page"): the main address shows a
# self-contained "coming soon" page, open to everyone, until launch. Switch off = remove the DNS records for
# tpalive.co.uk and www in Cloudflare. The test site above keeps its password.
tpalive.co.uk {
	encode gzip
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Content-Security-Policy "default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; frame-ancestors 'none'"
		-Server
	}
	root * /opt/tpa/soon
	file_server
}

www.tpalive.co.uk {
	redir https://tpalive.co.uk{uri} permanent
}

# kit 4.56 (owner 13 Nov 16:36: "yes its ok to do the cloudflare proof"): a password-free test address holding ONLY
# dummy files that tpa-cftest writes and removes (/var/lib/tpa-cftest; empty = every address answers "not found").
# Proves Cloudflare shares live tiles before Stage 1 is built. Needs the DNS record cftest (orange cloud) in
# Cloudflare; remove that record to switch it off. "tls internal": Cloudflare (SSL mode Full) talks to us with our own
# certificate, so nothing waits on a public certificate; plain http too, for SSL mode Flexible.
cftest.tpalive.co.uk, http://cftest.tpalive.co.uk {
	tls internal
	header {
		X-Robots-Tag "noindex, nofollow"
		-Server
	}
	header /r/* Cache-Control "public, max-age=86400, immutable"
	header /short/* Cache-Control "public, max-age=10"
	header /latest.json Cache-Control "public, max-age=2"
	root * /var/lib/tpa-cftest
	file_server
}
