#!/usr/bin/env python3
"""tpa-record (kit 4.14.3, owner 3 Nov 18:02: buses "appear like a page refresh a bit further on"). Read-only.
Saves two minutes of the REAL bus answers the map page receives (asked through HQ every 5 s, exactly as the page
asks) to one small file, so the builders can play them into the real page and measure every icon frame by frame.
Bus positions only (public data); no keys, no viewer details.
Run on the main server:  sudo tpa-record [seconds] [west south east north]   (default: 120 s, north Hull)"""
import gzip
import json
import sys
import time
import urllib.request


def main():
    args = sys.argv[1:]
    secs = int(args[0]) if args and args[0].isdigit() else 120
    box = args[1:5] if len(args) >= 5 else ['-0.39', '53.78', '-0.33', '53.80']
    q = f'west={box[0]}&south={box[1]}&east={box[2]}&north={box[3]}'
    opener = urllib.request.build_opener(urllib.request.ProxyHandler({}))
    out = '/tmp/tpa-record.jsonl.gz'
    n = 0
    print(f'Recording the bus answers for {secs} s (read-only)...')
    with gzip.open(out, 'wt') as f:
        f.write(json.dumps({'recorder': 'tpa-record 4.14.3', 'box': box, 'startedAt': time.time()}) + '\n')
        end = time.time() + secs
        while time.time() < end:
            t0 = time.time()
            for layer in ('bus',):
                try:
                    req = urllib.request.Request(f'http://127.0.0.1:8778/api/v4/components/{layer}/snapshot?{q}',
                                                 headers={'Host': '127.0.0.1:8778'})
                    with opener.open(req, timeout=10) as r:
                        f.write(json.dumps({'at': t0, 'layer': layer, 'frame': json.load(r)}) + '\n')
                        n += 1
                except Exception as exc:
                    f.write(json.dumps({'at': t0, 'layer': layer, 'error': type(exc).__name__}) + '\n')
            time.sleep(max(0, 5 - (time.time() - t0)))
    print(f'Saved {n} answers to {out}')


if __name__ == '__main__':
    main()
